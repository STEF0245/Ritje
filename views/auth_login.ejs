<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
        <main class="theme-main flex-1">
            <section class="max-w-xl mx-auto">
                <div class="text-center mb-8">
                    <p class="theme-kicker">Ritje Account</p>
                    <h1 class="theme-heading">
                        Welkom terug bij RITJE<span class="text-teal-400">.</span>
                    </h1>
                    <p class="theme-subtext">Log in en ga meteen verder met je volgende rit.</p>
                </div>

                <% if (authErrorReason) { %>
                    <%- include('partials/auth_error', { authErrorReason, authErrorType }) %>
                <% } %>

                <form
                    action="/auth/login"
                    method="post"
                    class="theme-panel p-6 md:p-8"
                >
                    <div>
                        <label for="email" class="block text-sm font-semibold mb-2 text-slate-300">E-mail</label>
                        <input
                            type="email"
                            name="email"
                            id="email"
                            placeholder="peter.selie@ritje.be"
                            autocomplete="email"
                            class="theme-input"
                            required
                        />
                    </div>

                    <div class="mt-4">
                        <label for="password" class="block text-sm font-semibold mb-2 text-slate-300">Wachtwoord</label>
                        <input
                            type="password"
                            name="password"
                            id="password"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            class="theme-input"
                            required
                        />
                    </div>

                    <div class="mt-6 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
                        <a href="/auth/register" class="text-sm theme-link">Nog geen account? Registreer hier</a>
                        <button
                            type="submit"
                            class="ride-accent hover:brightness-110 text-white font-bold py-3 px-5 rounded-xl cursor-pointer transition"
                        >
                            Inloggen
                        </button>
                    </div>
                </form>
            </section>
        </main>

        <%- include('partials/footer') %>
    </body>
</html>