<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
<%- include('partials/head', { title }) %>

    <%
        const profile = editUser || {}
        const fullName = profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
        const firstName = profile?.name?.first || fullName.split(' ')[0] || ''
        const lastName = profile?.name?.last || fullName.split(' ').slice(1).join(' ') || ''
        const initials = `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase() || 'OG'
        const email = profile?.email || ''
        const phoneNumber = profile?.phoneNumber || ''
        const city = profile?.address?.city || ''
        const street = profile?.address?.street || ''
        const houseNumber = profile?.address?.houseNumber || ''
        const postalCode = profile?.address?.postalCode || ''
        const photoURL = profile?.photoURL || ''
        const targetUid = userUid || '-'
        const createdAt = profile?.createdAt ? new Date(profile.createdAt).toLocaleString('nl-BE', {
            year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
        }) : 'Onbekend'
        const lastSignIn = profile?.lastSignInTime ? new Date(profile.lastSignInTime).toLocaleString('nl-BE', {
            year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
        }) : 'Onbekend'
        const isEmailVerified = Boolean(profile?.emailVerified)
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/header', { user }) %>
        <main class="theme-main flex-1 pt-0!">
            <%- include('partials/admin_nav', { selected: { users: true } }) %>

            <section class="max-w-5xl mx-auto px-4 md:px-6 py-8 md:py-10">
                <div class="mb-8 md:mb-10 text-center">
                    <p class="theme-kicker">Admin Gebruiker</p>
                    <h1 class="theme-heading">Gebruiker bewerken</h1>
                    <p class="theme-subtext">Werk profiel- en adresgegevens bij voor UID <span class="font-mono theme-text-primary"><%= targetUid %></span>.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-110">
                        <div class="flex items-center gap-4">
                            <% if (photoURL) { %>
                                <img src="<%= photoURL %>" alt="Profielfoto van <%= fullName %>" class="theme-avatar h-16 w-16 object-cover rounded-full">
                            <% } else { %>
                                <div class="theme-avatar h-16 w-16 flex items-center justify-center text-xl font-black">
                                    <%= initials %>
                                </div>
                            <% } %>
                            <div class="min-w-0">
                                <p class="theme-text-primary text-lg font-bold leading-tight truncate"><%= fullName %></p>
                                <p class="theme-text-muted text-sm truncate"><%= email || 'Geen e-mail gevonden' %></p>
                                <% if (phoneNumber) { %>
                                    <p class="theme-text-muted text-sm truncate"><%= phoneNumber %></p>
                                <% } %>
                            </div>
                        </div>

                        <div class="mt-6 border-t theme-border pt-5 space-y-3 text-sm flex-1">
                            <div class="flex items-center justify-between gap-4">
                                <span class="theme-text-muted">Gebruiker ID</span>
                                <span class="theme-text-primary font-mono text-xs break-all text-right"><%= targetUid %></span>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <span class="theme-text-muted">Aangemaakt op</span>
                                <span class="theme-text-primary"><%= createdAt %></span>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <span class="theme-text-muted">Laatst ingelogd</span>
                                <span class="theme-text-primary"><%= lastSignIn %></span>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <span class="theme-text-muted">E-mail bevestigd</span>
                                <span class="<%= isEmailVerified ? 'text-emerald-300' : 'text-amber-300' %>">
                                    <%= isEmailVerified ? 'Ja' : 'Nee' %>
                                </span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 grid grid-cols-1 gap-3">
                            <a href="/admin/users" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Terug naar overzicht</a>
                        </div>
                    </article>

                    <article class="theme-panel p-6 lg:col-span-2">
                        <h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
                        <p class="theme-text-muted text-sm mt-1">Werk account- en adresgegevens van deze gebruiker bij.</p>

                        <form method="post" action="/admin/users/<%= encodeURIComponent(targetUid) %>" class="mt-6 space-y-5">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="firstName" class="block mb-2 text-sm font-medium theme-text-primary">Voornaam</label>
                                    <input id="firstName" name="firstName" class="theme-input" value="<%= firstName %>" placeholder="Voornaam">
                                </div>
                                <div>
                                    <label for="lastName" class="block mb-2 text-sm font-medium theme-text-primary">Achternaam</label>
                                    <input id="lastName" name="lastName" class="theme-input" value="<%= lastName %>" placeholder="Achternaam">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="email" class="block mb-2 text-sm font-medium theme-text-primary">E-mail</label>
                                    <input id="email" name="email" type="email" class="theme-input" value="<%= email %>" placeholder="naam@domein.be">
                                </div>
                                <div>
                                    <label for="phoneNumber" class="block mb-2 text-sm font-medium theme-text-primary">Telefoonnummer</label>
                                    <input id="phoneNumber" name="phoneNumber" type="tel" class="theme-input" value="<%= phoneNumber %>" placeholder="0412345678">
                                </div>
                            </div>

                            <div>
                                <label for="photoURL" class="block mb-2 text-sm font-medium theme-text-primary">Profielfoto URL</label>
                                <input id="photoURL" name="photoURL" class="theme-input" value="<%= photoURL %>" placeholder="https://...">
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="md:col-span-2">
                                    <label for="street" class="block mb-2 text-sm font-medium theme-text-primary">Straat</label>
                                    <input id="street" name="street" class="theme-input" value="<%= street %>" placeholder="Straatnaam">
                                </div>
                                <div>
                                    <label for="houseNumber" class="block mb-2 text-sm font-medium theme-text-primary">Huisnummer</label>
                                    <input id="houseNumber" name="houseNumber" class="theme-input" value="<%= houseNumber %>" placeholder="12A">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="postalCode" class="block mb-2 text-sm font-medium theme-text-primary">Postcode</label>
                                    <input id="postalCode" name="postalCode" class="theme-input" value="<%= postalCode %>" placeholder="1000">
                                </div>
                                <div>
                                    <label for="city" class="block mb-2 text-sm font-medium theme-text-primary">Stad</label>
                                    <input id="city" name="city" class="theme-input" value="<%= city %>" placeholder="Brussel">
                                </div>
                            </div>

                            <div class="pt-2 flex flex-wrap gap-3">
                                <button type="submit" class="theme-btn-primary px-5 py-2.5">Opslaan</button>
                                <a href="/admin/users" class="theme-btn-secondary px-5 py-2.5">Annuleer</a>
                            </div>
                        </form>
                    </article>
                </div>
            </section>
        </main>
        <%- include('partials/footer') %>
    </body>
</html>
