<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

    <%
        const profile = editUser || {}
        const fullName = profile?.name?.full || profile?.displayName || ''
        const firstName = profile?.name?.first || fullName.split(' ')[0] || ''
        const lastName = profile?.name?.last || fullName.split(' ').slice(1).join(' ') || ''
        const email = profile?.email || ''
        const city = profile?.address?.city || ''
        const street = profile?.address?.street || ''
        const houseNumber = profile?.address?.houseNumber || ''
        const postalCode = profile?.address?.postalCode || ''
        const photoURL = profile?.photoURL || ''
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/navbar', { user }) %>
        <main class="theme-main flex-1">
            <%- include('partials/header', { user, kicker: 'Ritje Admin', heading: 'Gebruiker bewerken', subtext: `Werk profiel- en adresgegevens bij voor UID <span class="font-mono theme-text-primary">${userUid}</span>.` }) %>

			<section class="max-w-7xl mx-auto px-4 md:px-6">
				<div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start">
					<%- include('partials/admin_nav', { selected: { users: true } }) %>

					<div class="space-y-6">
						<article class="theme-panel p-6 md:p-8 text-center">
							<p class="theme-kicker">Admin Gebruiker</p>
							<h1 class="theme-heading">Gebruiker bewerken</h1>
							<p class="theme-subtext">Werk profiel- en adresgegevens bij voor UID <span class="font-mono theme-text-primary"><%= userUid %></span>.</p>
						</article>

						<article class="theme-panel p-5 md:p-6">
                            <form method="post" action="/admin/users/<%= encodeURIComponent(userUid) %>" class="space-y-5">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="firstName" class="block mb-2 text-sm font-medium theme-text-primary">Voornaam</label>
                                        <input id="firstName" name="firstName" class="theme-input" value="<%= firstName %>" placeholder="Voornaam">
                                    </div>
                                    <div>
                                        <label for="lastName" class="block mb-2 text-sm font-medium theme-text-primary">Achternaam</label>
                                        <input id="lastName" name="lastName" class="theme-input" value="<%= lastName %>" placeholder="Achternaam">
                                    </div>
                                </div>

                                <div>
                                    <label for="email" class="block mb-2 text-sm font-medium theme-text-primary">E-mail</label>
                                    <input id="email" name="email" type="email" class="theme-input" value="<%= email %>" placeholder="naam@domein.be">
                                </div>

                                <div>
                                    <label for="photoURL" class="block mb-2 text-sm font-medium theme-text-primary">Profielfoto URL</label>
                                    <input id="photoURL" name="photoURL" class="theme-input" value="<%= photoURL %>" placeholder="https://...">
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="md:col-span-2">
                                        <label for="street" class="block mb-2 text-sm font-medium theme-text-primary">Straat</label>
                                        <input id="street" name="street" class="theme-input" value="<%= street %>" placeholder="Straatnaam">
                                    </div>
                                    <div>
                                        <label for="houseNumber" class="block mb-2 text-sm font-medium theme-text-primary">Huisnummer</label>
                                        <input id="houseNumber" name="houseNumber" class="theme-input" value="<%= houseNumber %>" placeholder="12A">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="postalCode" class="block mb-2 text-sm font-medium theme-text-primary">Postcode</label>
                                        <input id="postalCode" name="postalCode" class="theme-input" value="<%= postalCode %>" placeholder="1000">
                                    </div>
                                    <div>
                                        <label for="city" class="block mb-2 text-sm font-medium theme-text-primary">Stad</label>
                                        <input id="city" name="city" class="theme-input" value="<%= city %>" placeholder="Brussel">
                                    </div>
                                </div>

                                <div class="pt-2 flex flex-wrap gap-3">
                                    <button type="submit" class="theme-btn-primary px-5 py-2.5">Opslaan</button>
                                    <a href="/admin/users" class="theme-btn-secondary px-5 py-2.5">Terug naar overzicht</a>
                                </div>
                            </form>
						</article>
					</div>
				</div>
			</section>
        </main>
        <%- include('partials/footer') %>
    </body>
</html>
