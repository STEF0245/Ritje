<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

    <%
        const profile = editUser || {}
        const fullName =
            profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
        const firstName = profile?.name?.first || fullName.split(' ')[0] || ''
        const lastName =
            profile?.name?.last || fullName.split(' ').slice(1).join(' ') || ''
        const initials = `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase() || 'OG'
        const email = profile?.email || ''
        const phoneNumber = profile?.phoneNumber || ''
        const city = profile?.address?.city || ''
        const street = profile?.address?.street || ''
        const houseNumber = profile?.address?.houseNumber || ''
        const postalCode = profile?.address?.postalCode || ''
        const photoURL = profile?.photoURL || ''
        const targetUid = userUid || '-'
        const createdAt = profile?.createdAt
            ? new Date(profile.createdAt).toLocaleString('nl-BE', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
              })
            : 'Onbekend'
        const lastSignIn = profile?.lastSignInTime
            ? new Date(profile.lastSignInTime).toLocaleString('nl-BE', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
              })
            : 'Onbekend'
        const isEmailVerified = Boolean(profile?.emailVerified)
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/header', { user }) %>
        <main class="theme-main flex-1 pt-0!">
            <%- include('partials/admin_nav', { selected: { users: true } }) %>

            <section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-fit">
						<%- include('partials/user_summary_card', {
							avatarUrl: photoURL,
							initials,
							userName: fullName,
							email,
							phoneNumber,
							uid: targetUid,
							createdAt,
							lastSignIn,
							emailVerified: isEmailVerified || false,
						}) %>

						<div class="mt-4 pt-3 grid grid-cols-2 gap-3">
							<a href="/admin/users/<%= encodeURIComponent(targetUid) %>" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Annuleer</a>
							<a href="/admin/users" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Overzicht</a>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
						<p class="theme-text-muted text-sm mt-1">Werk account- en adresgegevens van deze gebruiker bij.</p>

						<form method="post" action="/admin/users/<%= encodeURIComponent(targetUid) %>/edit" class="mt-6 space-y-4">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="firstName" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</label>
									<input id="firstName" name="firstName" class="mt-2 theme-input w-full" value="<%= firstName %>" placeholder="Voornaam">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="lastName" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</label>
									<input id="lastName" name="lastName" class="mt-2 theme-input w-full" value="<%= lastName %>" placeholder="Achternaam">
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="email" class="text-xs uppercase tracking-[0.12em] theme-text-muted">E-mail</label>
									<input id="email" name="email" type="email" class="mt-2 theme-input w-full" value="<%= email %>" placeholder="naam@domein.be">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="phoneNumber" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Telefoonnummer</label>
									<input id="phoneNumber" name="phoneNumber" type="tel" class="mt-2 theme-input w-full" value="<%= phoneNumber %>" placeholder="0412345678">
								</div>
							</div>

							<div class="theme-surface theme-pill border theme-border p-4 pt-3">
								<label for="photoURL" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Profielfoto URL</label>
								<input id="photoURL" name="photoURL" class="mt-2 theme-input w-full" value="<%= photoURL %>" placeholder="https://...">
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-2">
									<label for="street" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</label>
									<input id="street" name="street" class="mt-2 theme-input w-full" value="<%= street %>" placeholder="Straatnaam">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-1">
									<label for="houseNumber" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</label>
									<input id="houseNumber" name="houseNumber" class="mt-2 theme-input w-full" value="<%= houseNumber %>" placeholder="12A">
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="postalCode" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</label>
									<input id="postalCode" name="postalCode" class="mt-2 theme-input w-full" value="<%= postalCode %>" placeholder="1000">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="city" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</label>
									<input id="city" name="city" class="mt-2 theme-input w-full" value="<%= city %>" placeholder="Brussel">
								</div>
							</div>

							<div class="justify-self-end pt-2">
								<button type="submit" class="theme-btn-primary px-5 py-3 cursor-pointer">Opslaan</button>
							</div>
						</form>
					</article>
				</div>
			</section>
		</main>
		<%- include('partials/footer') %>
	</body>
</html>
