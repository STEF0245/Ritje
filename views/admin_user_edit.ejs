<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

    <%
        const profile = editUser || {}
        const fullName =
            profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
        const firstName = profile?.name?.first || fullName.split(' ')[0] || ''
        const lastName =
            profile?.name?.last || fullName.split(' ').slice(1).join(' ') || ''
        const initials = `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase() || 'OG'
        const email = profile?.email || ''
        const phoneNumber = profile?.phoneNumber || ''
        const city = profile?.address?.city || ''
        const street = profile?.address?.street || ''
        const houseNumber = profile?.address?.houseNumber || ''
        const postalCode = profile?.address?.postalCode || ''
        const photoURL = profile?.photoURL || ''
        const schedule = profile?.schedule || {}
        const targetUid = userUid || '-'
        const createdAt = profile?.createdAt
            ? new Date(profile.createdAt).toLocaleString('nl-BE', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
              })
            : 'Onbekend'
        const lastSignIn = profile?.lastSignInTime
            ? new Date(profile.lastSignInTime).toLocaleString('nl-BE', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
              })
            : 'Onbekend'
        const isEmailVerified = Boolean(profile?.emailVerified)

		const weekdays = [
			{ key: '1', label: 'Maandag' },
			{ key: '2', label: 'Dinsdag' },
			{ key: '3', label: 'Woensdag' },
			{ key: '4', label: 'Donderdag' },
			{ key: '5', label: 'Vrijdag' }
		]

		const getActiveHours = (hours) => {
			const normalizeHourNumber = (value) => {
				if (value === null || value === undefined) return null
				if (typeof value === 'string' && value.trim() === '') return null
				const numeric = Number(value)
				if (!Number.isInteger(numeric)) return null
				if (numeric >= 1 && numeric <= 8) return numeric
				if (numeric >= 0 && numeric <= 7) return numeric + 1
				return null
			}

			if (Array.isArray(hours)) {
				return hours
					.map((isActive, index) => (Boolean(isActive) ? String(index + 1) : null))
					.filter(Boolean)
			}
			if (hours && typeof hours === 'object') {
				if (
					Object.prototype.hasOwnProperty.call(hours, 'start') &&
					Object.prototype.hasOwnProperty.call(hours, 'end')
				) {
					const start = normalizeHourNumber(hours.start)
					const end = normalizeHourNumber(hours.end)
					if (!start || !end || end < start) return []
					return Array.from(
						{ length: end - start + 1 },
						(_, idx) => String(start + idx)
					)
				}

				return Object.entries(hours)
					.filter(([, isActive]) => Boolean(isActive))
					.map(([hour]) => normalizeHourNumber(hour))
					.filter((hour) => hour !== null)
					.map((hour) => String(hour))
					.filter((hour, index, list) => list.indexOf(hour) === index)
					.sort((a, b) => Number(a) - Number(b))
			}
			return []
		}

		const resolveDayHours = (dayKey) => {
			if (Object.prototype.hasOwnProperty.call(schedule, dayKey)) {
				return schedule[dayKey]
			}
			return {}
		}

		const normalizeHourValue = (value) => {
			if (value === null || value === undefined) return ''
			const hour = Number(String(value).trim())
			if (!Number.isInteger(hour) || hour < 1 || hour > 8) return ''
			return String(hour)
		}

		const hourOptions = [
			{ value: '1', labels: { first: '08:25', last: '09:15' } },
			{ value: '2', labels: { first: '09:15', last: '10:05' } },
			{ value: '3', labels: { first: '10:20', last: '11:10' } },
			{ value: '4', labels: { first: '11:10', last: '12:00' } },
			{ value: '5', labels: { first: '13:00', last: '13:50' } },
			{ value: '6', labels: { first: '13:50', last: '14:40' } },
			{ value: '7', labels: { first: '14:55', last: '15:45' } },
			{ value: '8', labels: { first: '15:45', last: '16:35' } }
		]
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/header', { user }) %>
        <main class="theme-main flex-1 pt-0!">
            <%- include('partials/admin_nav', { selected: { users: true } }) %>

            <section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-fit">
						<%- include('partials/user_summary_card', {
							avatarUrl: photoURL,
							initials,
							userName: fullName,
							email,
							phoneNumber,
							uid: targetUid,
							createdAt,
							lastSignIn,
							emailVerified: isEmailVerified || false,
						}) %>

						<div class="mt-4 pt-3 grid grid-cols-2 gap-3">
							<a href="/admin/users/<%= encodeURIComponent(targetUid) %>" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Annuleer</a>
							<a href="/admin/users" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Overzicht</a>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
						<p class="theme-text-muted text-sm mt-1">Werk account- en adresgegevens van deze gebruiker bij.</p>

						<form id="profile-edit-form" method="post" action="/admin/users/<%= encodeURIComponent(targetUid) %>/edit" class="mt-6 space-y-4">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="firstName" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</label>
									<input id="firstName" name="firstName" class="mt-2 theme-input w-full" value="<%= firstName %>" placeholder="Voornaam">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="lastName" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</label>
									<input id="lastName" name="lastName" class="mt-2 theme-input w-full" value="<%= lastName %>" placeholder="Achternaam">
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="email" class="text-xs uppercase tracking-[0.12em] theme-text-muted">E-mail</label>
									<input id="email" name="email" type="email" class="mt-2 theme-input w-full" value="<%= email %>" placeholder="naam@domein.be">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="phoneNumber" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Telefoonnummer</label>
									<input id="phoneNumber" name="phoneNumber" type="tel" class="mt-2 theme-input w-full" value="<%= phoneNumber %>" placeholder="0412345678">
								</div>
							</div>

							<div class="theme-surface theme-pill border theme-border p-4 pt-3">
								<label for="photoURL" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Profielfoto URL</label>
								<input id="photoURL" name="photoURL" class="mt-2 theme-input w-full" value="<%= photoURL %>" placeholder="https://...">
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-2">
									<label for="street" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</label>
									<input id="street" name="street" class="mt-2 theme-input w-full" value="<%= street %>" placeholder="Straatnaam">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-1">
									<label for="houseNumber" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</label>
									<input id="houseNumber" name="houseNumber" class="mt-2 theme-input w-full" value="<%= houseNumber %>" placeholder="12A">
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="postalCode" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</label>
									<input id="postalCode" name="postalCode" class="mt-2 theme-input w-full" value="<%= postalCode %>" placeholder="1000">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="city" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</label>
									<input id="city" name="city" class="mt-2 theme-input w-full" value="<%= city %>" placeholder="Brussel">
								</div>
							</div>

							<div class="justify-self-end pt-2">
								<button type="submit" class="theme-btn-primary px-5 py-3 cursor-pointer">Opslaan</button>
							</div>
						</form>
					</article>

					<article class="theme-panel p-6 lg:col-span-2 lg:col-start-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Uurrooster</h2>
						<p class="theme-text-muted text-sm mt-1">Overzicht van je uurrooster.</p>

						<div class="mt-6 space-y-4">
							<div class="theme-surface theme-pill border theme-border p-4">
								<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Beschikbaarheid per dag</p>
								<div class="mt-4 space-y-3">
									<% weekdays.forEach(({ key: dayKey, label: fixedDayLabel }, index) => { %>
										<%
											const dayHours = resolveDayHours(dayKey)
											const dayLabel = fixedDayLabel
											const activeHours = getActiveHours(dayHours)
											const rawFirst = activeHours[0]
											const first = normalizeHourValue(rawFirst)
											const rawLast = activeHours[activeHours.length - 1]
											const normalizedRawLast = normalizeHourValue(rawLast)
											const last = first && normalizedRawLast && Number(normalizedRawLast) < Number(first) ? first : normalizedRawLast
										%>
										<div class="grid grid-cols-1 md:grid-cols-3 gap-3 theme-surface-strong theme-pill border theme-border p-3" data-schedule-row>
											<div class="md:col-span-1 flex items-center">
												<p class="theme-text-primary font-semibold"><%= dayLabel %></p>
											</div>
											<div class="md:col-span-1">
												<label for="scheduleStart_<%= dayKey %>" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Van</label>
											<select id="scheduleStart_<%= dayKey %>" name="schedule_<%= dayKey %>_start" class="mt-2 theme-input w-full" form="profile-edit-form" data-schedule-start>
													<option value="">Niet beschikbaar</option>
													<% hourOptions.forEach((option) => { %>
														<option value="<%= option.value %>" <%= first === option.value ? 'selected' : '' %>><%= option.labels.first %></option>
													<% }) %>
												</select>
											</div>
											<div class="md:col-span-1">
												<label for="scheduleEnd_<%= dayKey %>" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Tot</label>
											<select id="scheduleEnd_<%= dayKey %>" name="schedule_<%= dayKey %>_end" class="mt-2 theme-input w-full" form="profile-edit-form" data-schedule-end>
													<option value="">Niet beschikbaar</option>
													<% hourOptions.forEach((option) => { %>
														<option value="<%= option.value %>" <%= last === option.value ? 'selected' : '' %>><%= option.labels.last %></option>
													<% }) %>
												</select>
											</div>
										</div>
									<% }) %>
								</div>
							</div>
							<div class="flex justify-end pt-2">
								<button type="submit" form="profile-edit-form" class="theme-btn-primary px-5 py-3 cursor-pointer">Opslaan</button>
							</div>
						</div>
					</article>
				</div>
			</section>
		</main>
		<%- include('partials/footer') %>
	</body>
</html>
