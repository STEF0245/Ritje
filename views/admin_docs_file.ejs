<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
		<main class="theme-main flex-1 pt-0!">
			<%- include('partials/admin_nav', { selected: { docs: true } }) %>

			<section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10 space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div>
						<p class="theme-kicker">Ritje Admin</p>
						<h1 class="theme-heading theme-accent-text">Bestandsdocumentatie</h1>
					</div>
					<a href="/admin/docs" class="theme-btn-secondary px-3 py-2 text-sm">Terug naar structuur</a>
				</div>

				<% if (!file || !group) { %>
					<article class="theme-panel p-8 md:p-10 text-center">
						<h2 class="text-xl font-extrabold theme-text-primary">Bestand niet gevonden</h2>
						<p class="theme-subtext">Ga terug naar het overzicht en kies een geldig bestand.</p>
					</article>
				<% } else { %>
					<article class="theme-panel p-5 md:p-6 space-y-2">
						<p class="theme-kicker"><%= group.label %></p>
						<h2 class="text-xl md:text-2xl font-black theme-text-primary break-all"><%= file.name %></h2>
						<p class="theme-text-muted text-sm font-mono break-all"><%= group.rootLabel %>/<%= file.relativePath %></p>
						<div class="flex flex-wrap gap-2 text-xs pt-2">
							<span class="theme-surface border theme-border rounded-md px-2 py-1">.<%= file.extension || 'noext' %></span>
							<span class="theme-surface border theme-border rounded-md px-2 py-1"><%= file.lineCount %> regels</span>
							<span class="theme-surface border theme-border rounded-md px-2 py-1"><%= (file.documentationSections || []).length %> doc blokken</span>
						</div>
					</article>

					<article class="theme-panel p-5 md:p-6">
						<div class="flex items-center justify-between gap-3 mb-4">
							<h3 class="text-sm font-bold uppercase tracking-[0.16em] theme-text-muted">Documentatie</h3>
							<span class="theme-text-muted text-xs">Bovenaan samengevat, met links naar bronregels</span>
						</div>
						<% if ((file.documentationSections || []).length === 0) { %>
							<p class="theme-text-muted text-sm">Geen documentatieblokken gevonden.</p>
						<% } else { %>
							<div class="space-y-3">
								<% file.documentationSections.forEach((section) => { %>
									<section class="theme-surface border theme-border rounded-md p-4">
										<div class="flex items-center justify-between gap-3">
											<h4 class="theme-text-primary font-semibold text-sm"><%= section.title %></h4>
											<a href="#L<%= section.lineNumber %>" class="theme-link text-xs">Regel <%= section.lineNumber %></a>
										</div>
										<div class="mt-2 docs-doc-body text-sm theme-text-muted">
											<% section.content.split(/\r?\n/).forEach((line) => { %>
												<% if (line && line.trim()) { %>
													<p><%= line %></p>
												<% } %>
											<% }) %>
										</div>
									</section>
								<% }) %>
							</div>
						<% } %>
					</article>

					<article class="theme-panel p-4 md:p-5 max-h-[75vh] overflow-auto">
						<div class="flex items-center justify-between gap-3 mb-3">
							<h3 class="text-xs font-bold uppercase tracking-[0.16em] theme-text-muted">Broncode</h3>
							<span class="theme-text-muted text-xs">Onderaan volledige bron met klikbare regelnummers</span>
						</div>
						<pre class="theme-code docs-source-block text-xs"><code><%- sourceWithLineAnchors %></code></pre>
					</article>
				<% } %>
			</section>
		</main>
		<%- include('partials/footer') %>
	</body>
</html>
