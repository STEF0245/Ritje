<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/navbar', { user }) %>
        <main class="theme-main flex-1">
            <%- include('partials/header', { user, kicker: 'Ritje Admin', heading: 'Nieuwe gebruiker', subtext: 'Deze pagina staat klaar in de admin sidebar layout. Voeg hier later het aanmaakformulier toe.' }) %>
            
            <section class="max-w-7xl mx-auto px-4 md:px-6">
                <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start">
                    <%- include('partials/admin_nav', { selected: { users: true } }) %>

                    <div class="space-y-6">
                        <article class="theme-panel p-6 md:p-8 text-center">
                            <p class="theme-kicker">Admin Gebruiker</p>
                            <h1 class="theme-heading">Nieuwe gebruiker</h1>
                            <p class="theme-subtext">Deze pagina staat klaar in de admin sidebar layout. Voeg hier later het aanmaakformulier toe.</p>
                            <div class="mt-6">
                                <a href="/admin/users" class="theme-btn-secondary px-4 py-3 text-sm">Terug naar gebruikers</a>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </main>
        <%- include('partials/footer') %>
    </body>
</html>