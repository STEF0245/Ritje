<%
    const mapMarkersJson = JSON.stringify(locals.mapMarkers) || '[]';
    const routeJson = JSON.stringify(locals.route) || 'null';
    const suggestionMarkers = locals.suggestionMarkers || [];
    const rideSettings = locals.rideSettings || {};
    const seatLimit = Number(rideSettings?.seats?.total || 1);
%>

<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>
    
	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
        <main class="theme-main flex-1">
            <section class="max-w-6xl mx-auto" data-ride-page>
                <article class="theme-panel p-6 mb-6 ride-hero-panel">
                    <div class="flex flex-col gap-4">
                        <div>
                            <h1 class="text-2xl font-extrabold theme-text-primary">Uw rit plannen</h1>
                            <p class="theme-text-muted text-sm mt-1">Bekijk uw route, ontvang suggesties en bevestig uw rit.</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <%- include('partials/day_schedule_selector', {
                                daySchedules,
                                hasAnySchedule,
                                selectedKey,
                                selectedValue,
                                basePath: '/ride',
                                emptyMessage: 'Je hebt nog geen uurrooster ingesteld.'
                            }) %>
                        </div>
                    </div>
                </article>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-2 ride-map-panel">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <div>
                                <h2 class="text-xl font-extrabold theme-text-primary">Routeoverzicht</h2>
                                <p class="theme-text-muted text-sm mt-1">Bekijk uw huidige route en ophalingen op de kaart.</p>
                            </div>
                        </div>
                        <div
                            data-map
                            data-markers='<%= mapMarkersJson %>'
                            data-route='<%= routeJson %>'
                            data-school-marker="true"
                            class="w-full h-125 mt-6 theme-pill border theme-border"
                            data-empty-state-behavior="show-message"
                            data-center="true"
                        ></div>
                    </article>

                    <article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-130 ride-suggestion-panel">
                        <h2 class="text-xl font-extrabold theme-text-primary">Suggesties</h2>
                            <p class="theme-text-muted text-sm mt-1">Selecteer een of meerdere personen en bereken de route om hun locatie op de kaart te tonen.</p>
                        <div class="mt-4 flex-1 overflow-y-auto" data-ride-suggestions data-seat-limit="<%= seatLimit %>" data-current-ride='<%= JSON.stringify(locals.currentRide || null) %>'>
                            <% if (suggestionMarkers.length > 0) { %>
                                <ul class="space-y-3">
                                    <% suggestionMarkers.forEach((ride, index) => { %>
                                            <% const detourDistance = ride.detour?.distance ?? ride.detourDistanceKm; %>
                                            <% const detourDuration = ride.detour?.duration ?? ride.detourDurationMinutes; %>
                                        <label class="theme-pill p-4 border theme-border theme-surface ride-suggestion-item cursor-pointer block">
                                            <input
                                                type="checkbox"
                                                class="ride-suggestion-check hidden"
                                                data-suggestion-checkbox
                                                value="<%= ride.uid || '' %>"
                                                aria-label="Selecteer <%= ride.title || `persoon ${index + 1}` %>"
                                                <% if (locals.currentRide?.suggestionIds?.includes(ride.uid)) { %>checked<% } %>
                                            />
                                            <span class="min-w-0 flex-1">
                                                <h4 class="text-base font-semibold theme-text-primary leading-tight"><%= ride.title || 'Onbekende persoon' %></h4>
                                                <p class="text-sm theme-text-muted"><%= ride.lines[1] || 'Onbekend adres' %></p>
                                                    <% if (Number.isFinite(detourDistance) && Number.isFinite(detourDuration)) { %>
                                                    <div class="mt-2 flex flex-wrap gap-2">
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                                +<%= Math.round(detourDistance * 10) / 10 %> km
                                                        </span>
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                                +<%= Math.round(detourDuration) %> min
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </span>
                                        </label>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p class="text-sm theme-text-muted">Er zijn momenteel geen suggesties beschikbaar.</p>
                            <% } %>
                        </div>
                        <button id="calculateRoute" class="theme-btn-primary px-4 py-2 mt-4 font-medium! hidden!">Route berekenen</button>
                        <button id="saveRoute" class="theme-btn-primary px-4 py-2 mt-4 font-medium! hidden!">Route opslaan</button>
                    </article>

                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
		<%- include('partials/map') %>
		<script src="/js/ride.js"></script>
    </body>
</html>