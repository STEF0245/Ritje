<%
    const mapMarkersJson = JSON.stringify(locals.mapMarkers) || '[]';
    const routeJson = JSON.stringify(locals.route) || 'null';
    const schedule = locals.user?.metadata?.schedule || {};


    const weekdays = [
		{ key: '1', label: 'Maandag', legacyKey: 'monday' },
		{ key: '2', label: 'Dinsdag', legacyKey: 'tuesday' },
		{ key: '3', label: 'Woensdag', legacyKey: 'wednesday' },
		{ key: '4', label: 'Donderdag', legacyKey: 'thursday' },
		{ key: '5', label: 'Vrijdag', legacyKey: 'friday' }
	]

    const normalizeHourNumber = (value) => {
		if (value === null || value === undefined) return null
		if (typeof value === 'string' && value.trim() === '') return null
		const numeric = Number(value)
		if (!Number.isInteger(numeric)) return null
		if (numeric >= 1 && numeric <= 8) return numeric
		if (numeric >= 0 && numeric <= 7) return numeric + 1
		return null
	}


	const resolveHourLabel = (hour, isStart) => {
		const hourMap = {
			'1': ['8:25', '9:15'],
			'2': ['9:15', '10:20'],
			'3': ['10:20', '11:10'],
			'4': ['11:10', '12:00'],
			'5': ['13:00', '13:50'],
			'6': ['13:50', '14:40'],
			'7': ['14:55', '15:45'],
			'8': ['15:45', '16:35']
		}
		if (!hour) return null
		const hourNumber = Number(hour)
		if (isNaN(hourNumber) || hourNumber < 1 || hourNumber > 8)
			return null
		const [start, end] = hourMap[hour] || []
		return isStart ? start : end
	}

	const getActiveHours = (hours) => {
		if (Array.isArray(hours)) {
			return hours
				.map((isActive, index) => (Boolean(isActive) ? String(index + 1) : null))
				.filter(Boolean)
		}
		if (hours && typeof hours === 'object') {
			if (
				Object.prototype.hasOwnProperty.call(hours, 'start') &&
				Object.prototype.hasOwnProperty.call(hours, 'end')
			) {
				const start = normalizeHourNumber(hours.start)
				const end = normalizeHourNumber(hours.end)
				if (!start || !end || end < start) return []
				return Array.from(
					{ length: end - start + 1 },
					(_, idx) => String(start + idx)
				)
			}

			return Object.entries(hours)
				.filter(([, isActive]) => Boolean(isActive))
				.map(([hour]) => normalizeHourNumber(hour))
				.filter((hour) => hour !== null)
				.map((hour) => String(hour))
				.filter((hour, index, list) => list.indexOf(hour) === index)
				.sort((a, b) => Number(a) - Number(b))
		}
		return []
	}

    const resolveDayHours = (dayKey, legacyKey) => {
		if (Object.prototype.hasOwnProperty.call(schedule, dayKey)) {
			return schedule[dayKey]
		}
		if (legacyKey && Object.prototype.hasOwnProperty.call(schedule, legacyKey)) {
			return schedule[legacyKey]
		}
		return null
	}

	const computeStartEnd = (dayHours) => {
		if (!dayHours) return { startHour: null, endHour: null }

		// explicit object with start/end
		if (typeof dayHours === 'object' && Object.prototype.hasOwnProperty.call(dayHours, 'start') && Object.prototype.hasOwnProperty.call(dayHours, 'end')) {
			const start = normalizeHourNumber(dayHours.start)
			const end = normalizeHourNumber(dayHours.end)
			if (!start || !end || end < start) return { startHour: null, endHour: null }
			return { startHour: String(start), endHour: String(end) }
		}

		// fallback to active hours (array or map)
		const active = getActiveHours(dayHours)
		if (!active || active.length === 0) return { startHour: null, endHour: null }
		return { startHour: active[0], endHour: active[active.length - 1] }
	}
%>

<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>
    
	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
        <main class="theme-main flex-1">
            <section class="max-w-6xl mx-auto" data-ride-page>
                <article class="theme-panel p-6 mb-6 ride-hero-panel">
                    <div class="flex flex-col gap-4">
                        <div>
                            <h1 class="text-2xl font-extrabold theme-text-primary">Uw rit plannen</h1>
                            <p class="theme-text-muted text-sm mt-1">Bekijk uw route, ontvang suggesties en bevestig uw rit.</p>
                        </div>
                        <div class="flex items-center gap-3">
							<% const hasAnySchedule = Boolean(schedule && schedule.length > 0) %>
							<% if (hasAnySchedule) { %>
								<div class="flex flex-row items-center gap-4 w-full">
									<% weekdays.forEach(({ key, label, legacyKey }) => {
                                        const startHour = schedule[key] && schedule[key].start || null
										const endHour = schedule[key] && schedule[key].end || null
										const startLabel = resolveHourLabel(startHour, true)
										const endLabel = resolveHourLabel(endHour, false)
										const isAvailable = Boolean(startLabel && endLabel)
									%>
                                        <div class="theme-surface theme-pill border theme-border p-4">
                                            <h3 class="text-xs uppercase tracking-[0.12em] theme-text-muted"><%= label %></h3>
                                            <% if (isAvailable) { %>
                                                <div class="flex flex-row gap-2 mt-2">
													<input ride-input type="radio" name="day_time" id="<%= key %>_start" class="hidden" />
                                                    <label ride-label for="<%= key %>_start" class="theme-pill border theme-border px-4 py-2 text-xs theme-text-muted cursor-pointer"><%= startLabel %></label>
													<input ride-input type="radio" name="day_time" id="<%= key %>_end" class="hidden" />
                                                    <label ride-label for="<%= key %>_end" class="theme-pill border theme-border px-4 py-2 text-xs theme-text-muted cursor-pointer"><%= endLabel %></label>
                                                </div>
                                            <% } else { %>
                                                <p class="theme-text-muted text-xs">Niet beschikbaar</p>
                                            <% } %>
                                        </div>
									<% }) %>
								</div>
							<% } else { %>
								<p class="theme-text-muted">Je hebt nog geen uurrooster ingesteld.</p>
							<% } %>
                        </div>
                    </div>
                </article>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-2 ride-map-panel">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <div>
                                <h2 class="text-xl font-extrabold theme-text-primary">Routeoverzicht</h2>
                                <p class="theme-text-muted text-sm mt-1">Bekijk uw huidige route en geüpdatete ophalingen op de kaart.</p>
                            </div>
                            <div class="theme-pill border theme-border theme-surface px-2.5 py-1 text-xs theme-text-muted">School als eindpunt</div>
                        </div>
                        <div
                            data-map
                            data-markers='<%= mapMarkersJson %>'
                            data-route='<%= routeJson %>'
                            data-school-marker="true"
                            class="w-full h-125 mt-6 theme-pill border theme-border"
                            data-empty-state-behavior="show-message"
                            data-center="true"
                        ></div>
                    </article>

                    <article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-130 ride-suggestion-panel">
                        <h2 class="text-xl font-extrabold theme-text-primary">Suggesties</h2>
                        <p class="theme-text-muted text-sm mt-1">Selecteer een of meerdere personen en herbereken de route om hun locatie op de kaart te tonen.</p>
                        <div class="mt-6 flex-1 overflow-y-auto">
                            <% if (locals.suggestionMarkers && locals.suggestionMarkers.length > 0) { %>
                                <ul class="space-y-3">
                                    <% locals.suggestionMarkers.forEach((ride, index) => { %>
                                        <label class="theme-pill p-4 border theme-border theme-surface ride-suggestion-item cursor-pointer block">
                                            <input
                                                type="checkbox"
                                                class="ride-suggestion-check hidden"
                                                data-suggestion-checkbox
                                                value="<%= ride.uid || '' %>"
                                                aria-label="Selecteer <%= ride.title || `persoon ${index + 1}` %>"
                                            />
                                            <span class="min-w-0 flex-1">
                                                <h4 class="text-base font-semibold theme-text-primary leading-tight"><%= ride.title || 'Onbekende persoon' %></h4>
                                                <p class="text-sm theme-text-muted"><%= ride.lines[1] || 'Onbekend adres' %></p>
                                                <% if (Number.isFinite(ride.detourDistanceKm) && Number.isFinite(ride.detourDurationMinutes)) { %>
                                                    <div class="mt-2 flex flex-wrap gap-2">
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                            +<%= Math.round(ride.detourDistanceKm * 10) / 10 %> km
                                                        </span>
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                            +<%= Math.round(ride.detourDurationMinutes) %> min
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </span>
                                        </label>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p class="text-sm theme-text-muted">Er zijn momenteel geen suggesties beschikbaar.</p>
                            <% } %>
                        </div>
                    </article>

                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
		<%- include('partials/map') %>
		<script src="/js/ride.js"></script>
    </body>
</html>