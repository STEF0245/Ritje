<%
    const mapMarkers = Array.isArray(locals.mapMarkers) ? [...locals.mapMarkers] : []
    const mapMarkersJson = JSON.stringify(mapMarkers) || '[]'
    const routeJson = JSON.stringify(locals.route) || 'null'

    const selectedDay = Number(locals.day)
    const selectedHour = Number(locals.hour)
    const hasDayHour = Number.isInteger(selectedDay) && Number.isInteger(selectedHour)
    const schedule = locals.daySchedules || []

    const hasActiveRide = !!locals.activeRide
%>

<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>
    
	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
        <main class="theme-main flex-1">
            <section class="max-w-6xl mx-auto" data-ride-page>
                <article class="theme-panel p-6 mb-6 ride-hero-panel">
                    <div class="flex flex-col gap-4">
                        <div>
                            <h1 class="text-2xl font-extrabold theme-text-primary">Uw rit plannen</h1>
                            <p class="theme-text-muted text-sm mt-1">Bekijk uw route, ontvang suggesties en bevestig uw rit.</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <%- include('partials/day_schedule_selector', {
                                schedule,
                                selectedDay,
                                selectedHour,
                                emptyMessage: 'Je hebt nog geen uurrooster ingesteld.'
                            }) %>
                        </div>
                    </div>
                </article>

                <article class="theme-panel p-6 mb-6">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div class="max-w-2xl">
                            <h2 class="text-xl font-extrabold theme-text-primary">
                                <% if (hasActiveRide) { %>
                                    Uw actieve rit staat klaar
                                <% } else if (invitationRides.length > 0) { %>
                                    Rituitnodigingen gevonden
                                <% } else { %>
                                    Geen actieve rit
                                <% } %>
                            </h2>
                            <p class="theme-text-muted text-sm mt-1">
                                <% if (hasActiveRide) { %>
                                    Als bestuurder kunt u deze rit annuleren of aanpassen via de ritpagina.
                                <% } else if (invitationRides.length > 0) { %>
                                    U kunt een uitnodiging accepteren of weigeren voordat u zelf een nieuwe rit aanmaakt.
                                <% } else { %>
                                    U hebt nog geen actieve rit. Voeg er een toe vanuit dit dashboard.
                                <% } %>
                            </p>
                        </div>
                        
                        <div class="flex flex-wrap gap-3">
                            <% if (hasActiveRide && hasDayHour) { %>
                                <form method="POST" action="/ride/<%= selectedDay %>/<%= selectedHour %>/cancel">
                                    <button type="submit" class="theme-btn-secondary px-5 py-3 rounded-xl font-bold inline-flex items-center gap-2">
                                        <i class="fa-solid fa-ban"></i>
                                        Rit annuleren
                                    </button>
                                </form>
                                <a href="/ride/<%= selectedDay %>/<%= selectedHour %>/edit" class="theme-btn-primary px-5 py-3 rounded-xl font-bold inline-flex items-center gap-2">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                    Rit aanpassen
                                </a>
                            <% } else if (invitationRides.length > 0) { %>
                                <a href="/ride/<%= selectedDay %>/<%= selectedHour %>/edit" class="theme-btn-primary px-5 py-3 rounded-xl font-bold inline-flex items-center gap-2">
                                    <i class="fa-solid fa-plus"></i>
                                    Eigen rit toevoegen
                                </a>
                            <% } else { %>
                                <a href="/ride/<%= selectedDay %>/<%= selectedHour %>/edit" class="theme-btn-primary px-5 py-3 rounded-xl font-bold inline-flex items-center gap-2">
                                    <i class="fa-solid fa-plus"></i>
                                    Rit toevoegen
                                </a>
                            <% } %>
                        </div>
                    </div>
                    
                    <% if (invitationRides.length > 0 && hasDayHour) { %>
                        <div class="mt-6 grid grid-cols-1 gap-4">
                            <% invitationRides.forEach((ride) => { %>
                                <div class="theme-pill border theme-border theme-surface p-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                                    <div>
                                        <h3 class="font-bold theme-text-primary">
                                            <%= ride.driverName || 'Een bestuurder' %>
                                        </h3>
                                        <p class="text-sm theme-text-muted">
                                            <%= ride.passengerResponse?.status === 'accepted' ? 'Geaccepteerd' : ride.passengerResponse?.status === 'rejected' ? 'Geweigerd' : 'In afwachting van uw antwoord' %>
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap gap-3">
                                        <form method="POST" action="/ride/<%= selectedDay %>/<%= selectedHour %>/respond">
                                            <input type="hidden" name="driverUid" value="<%= ride.driverUid %>">
                                            <input type="hidden" name="response" value="accepted">
                                            <button type="submit" class="theme-btn-primary px-4 py-2 rounded-xl font-bold inline-flex items-center gap-2">
                                                <i class="fa-solid fa-check"></i>
                                                Accepteren
                                            </button>
                                        </form>
                                        <form method="POST" action="/ride/<%= selectedDay %>/<%= selectedHour %>/respond">
                                            <input type="hidden" name="driverUid" value="<%= ride.driverUid %>">
                                            <input type="hidden" name="response" value="rejected">
                                            <button type="submit" class="theme-btn-secondary px-4 py-2 rounded-xl font-bold inline-flex items-center gap-2">
                                                <i class="fa-solid fa-xmark"></i>
                                                Weigeren
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </article>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-2 ride-map-panel">
                        <div class="flex items-start justify-between gap-3 flex-wrap">
                            <div>
                                <h2 class="text-xl font-extrabold theme-text-primary">Routeoverzicht</h2>
                                <p class="theme-text-muted text-sm mt-1">Bekijk uw huidige route en ophalingen op de kaart.</p>
                            </div>
                        </div>
                        <div
                            data-map
                            data-markers='<%= mapMarkersJson %>'
                            data-route='<%= routeJson %>'
                            data-school-marker="true"
                            class="w-full h-125 mt-6 theme-pill border theme-border"
                            data-empty-state-behavior="show-message"
                            data-center="true"
                        ></div>
                    </article>

                    <article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-130">
                        <h2 class="text-xl font-extrabold theme-text-primary">Ritdetails</h2>
                        <p class="theme-text-muted text-sm mt-1">Bekijk de details van je huidige rit.</p>
                        <div class="mt-4 flex-1 overflow-y-auto">
                            <% if (mapMarkers.length > 2) { %>
                                <ul class="space-y-3">
                                    <% mapMarkers.forEach((ride) => { %>
                                        <% const detourDistance = ride.detour?.distance ?? ride.detourDistanceKm; %>
                                        <% const detourDuration = ride.detour?.duration ?? ride.detourDurationMinutes; %>
                                        <div class="theme-pill p-4 border theme-border theme-surface ride-suggestion-item cursor-pointer block">
                                            <span class="min-w-0 flex-1">
                                                <h4 class="text-base font-semibold theme-text-primary leading-tight"><%= ride.title || 'Onbekende persoon' %></h4>
                                                <p class="text-sm theme-text-muted"><%= ride.lines?.[1] || 'Onbekend adres' %></p>
                                                <% if (Number.isFinite(detourDistance) && Number.isFinite(detourDuration)) { %>
                                                    <div class="mt-2 flex flex-wrap gap-2">
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                            +<%= Math.round(detourDistance * 10) / 10 %> km
                                                        </span>
                                                        <span class="theme-pill border theme-border px-2 py-1 text-xs theme-text-muted">
                                                            +<%= Math.round(detourDuration) %> min
                                                        </span>
                                                    </div>
                                                <% } %>
                                            </span>
                                        </div>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p class="text-sm theme-text-muted">Geen ritdetails beschikbaar.</p>
                            <% } %>
                        </div>
                    </article>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>
		<%- include('partials/map', {
            schoolConfig: locals.schoolMarkerData,
        }) %>
    </body>
</html>