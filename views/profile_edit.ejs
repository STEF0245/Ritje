<%# @file Profile edit form for updating the authenticated user's address data. %>

<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<% 
		const metadata = user?.metadata || {}
		const firstName = metadata?.name?.first || ''
		const lastName = metadata?.name?.last || ''
		const fullName = `${metadata?.name?.full || ''}`.trim() || 'Ritje Gebruiker'
		const initials = fullName.split(' ').filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || 'A'

		const photoURL = user?.photoURL || null
		const phoneNumber = user?.phoneNumber || ''
		const joinedDate = user?.createdAt ? new Date(user.createdAt).toLocaleString('nl-BE', { 
			year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' 
		}) : 'Onbekend';

		const lastSignInDate = user?.lastSignInTime ? new Date(user.lastSignInTime).toLocaleString('nl-BE', { 
			year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' 
		}) : 'Onbekend';
		const address = metadata?.address || {}
		const safeFormData = locals?.formData || {}
		const street = safeFormData?.street || address?.street || ''
		const houseNumber = safeFormData?.houseNumber || address?.houseNumber || ''
		const postalCode = safeFormData?.postalCode || address?.postalCode || ''
		const city = safeFormData?.city || address?.city || ''
	%>
	<%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>

		<main class="theme-main flex-1">
			<section class="max-w-6xl mx-auto">
				<div class="mb-8 md:mb-10 text-center">
					<p class="theme-kicker">Ritje Profiel</p>
					<h1 class="theme-heading">Welkom, <span class="theme-accent-text"><%= fullName %></span></h1>
					<p class="theme-subtext">Bekijk je accountgegevens en profielinformatie.</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-fit">
						<%- include('partials/user_summary_card', {
							avatarUrl: photoURL,
							initials,
							userName: fullName,
							email: user?.email || 'Geen e-mail gevonden',
							phoneNumber,
							uid: user?.uid || '-',
							createdAt: joinedDate,
							lastSignIn: lastSignInDate,
							emailVerified: user?.email_verified,
							verifiedLabel: user?.email_verified ? 'Ja' : 'Nee'
						}) %>

						<div class="mt-4 pt-3 grid grid-cols-2 gap-3">
							<% if (user?.isAdmin) { %>
								<a href="/admin" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center col-span-2">Admin Panel</a>
							<% } %>
							<a href="/profile" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Annuleer</a>
							<form action="/logout" method="post" class="w-full">
								<button type="submit" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center cursor-pointer">Uitloggen</button>
							</form>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
						<p class="theme-text-muted text-sm mt-1">Overzicht van je account en adresinformatie.</p>

						<form class="mt-6 space-y-4" method="post" action="/profile/edit">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= firstName || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= lastName || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-2">
									<label for="street" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</label>
									<input required type="text" name="street" id="street" class="mt-2 theme-input w-full" placeholder="Straatnaam invoeren" value="<%= street %>">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3 md:col-span-1">
									<label for="houseNumber" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</label>
									<input required type="text" name="houseNumber" id="houseNumber" class="mt-2 theme-input w-full" placeholder="Huisnummer invoeren" value="<%= houseNumber %>">
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="postalCode" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</label>
									<input required type="text" name="postalCode" id="postalCode" class="mt-2 theme-input w-full" placeholder="Postcode invoeren" value="<%= postalCode || '-' %>">
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 pt-3">
									<label for="city" class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</label>
									<input required type="text" name="city" id="city" class="mt-2 theme-input w-full" placeholder="Stad invoeren" value="<%= city || '-' %>">
								</div>
							</div>

							<div class="justify-self-end pt-2">
								<button type="submit" class="theme-btn-primary px-5 py-3 cursor-pointer">Opslaan</button>
							</div>
						</form>
					</article>
				</div>
			</section>
		</main>

		<%- include('partials/footer') %>
	</body>
</html>
