<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
        <main class="theme-main flex-1">
            <section class="max-w-xl mx-auto">
                <form
                    action="/login"
                    method="post"
                    id="login-form"
                    class="theme-panel p-6 md:p-8"
                >
                    <input type="hidden" name="idToken" id="idToken" />
                    <div>
                        <label for="email" class="block text-sm font-semibold mb-2 text-slate-300">E-mail</label>
                        <input
                            type="email"
                            name="email"
                            id="email"
                            placeholder="peter.selie@ritje.be"
                            autocomplete="email"
                            class="theme-input"
                            required
                        />
                    </div>

                    <div class="mt-4">
                        <label for="password" class="block text-sm font-semibold mb-2 text-slate-300">Wachtwoord</label>
                        <input
                            type="password"
                            name="password"
                            id="password"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            class="theme-input"
                            required
                        />
                    </div>
                    
                    <div id="login-status" class="mt-4 text-sm text-red-500 font-medium"></div>

                    <div class="mt-6 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
                        <button
                            type="submit"
                            class="theme-btn-primary py-3 px-5 cursor-pointer"
                        >
                            Inloggen
                        </button>
                    </div>
                </form>
            </section>
        </main>

        <script type="module" src="/js/auth_login.js"></script>

        <%- include('partials/footer') %>
    </body>
</html>