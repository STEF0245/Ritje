<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/navbar', { user }) %>
        <main class="theme-main flex-1">
            <%- include('partials/header', { user, kicker: 'Ritje Admin', heading: 'Dashboard', subtext: 'Gebruik het menu links om gebruikers en instellingen te beheren.' }) %>

            <section class="max-w-7xl mx-auto px-4 md:px-6">
                <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start">
                    <%- include('partials/admin_nav', { selected: { dashboard: true } }) %>

                    <div class="space-y-6">
                        <article class="theme-panel p-6 md:p-8">
                            <p class="theme-kicker">Ritje Admin</p>
                            <h1 class="theme-heading theme-accent-text mt-2">Dashboard</h1>
                            <p class="theme-subtext">Gebruik het menu links om gebruikers en instellingen te beheren.</p>

                            <div class="mt-6 grid gap-3 sm:grid-cols-2">
                                <a href="/admin/users" class="theme-btn-secondary px-4 py-3 text-sm">Gebruikers beheren</a>
                                <a href="/admin/settings" class="theme-btn-secondary px-4 py-3 text-sm">Instellingen openen</a>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </main>
        <%- include('partials/footer') %>
    </body>
</html>