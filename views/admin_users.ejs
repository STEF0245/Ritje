<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

    <%
        const userEntries = Object.entries(users || {})
        const userCount = userEntries.length
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/header', { user }) %>
        <main class="theme-main flex-1 pt-0!">
            <%- include('partials/admin_nav', { selected: { users: true } }) %>

            <section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10">
				<div class="mb-8 md:mb-10 text-center">
                    <p class="theme-kicker">Ritje Admin</p>
                    <h1 class="theme-heading theme-accent-text">Gebruikers</h1>
                    <p class="theme-subtext">Bekijk alle gebruikers in een overzicht.</p>
                </div>

                <div class="mb-8 md:mb-10 flex mx-auto w-xl justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <button
                            id="userViewListBtn"
                            type="button"
                            class="theme-btn-secondary px-4 py-2"
                            aria-label="Toon lijstweergave"
                            aria-pressed="true"
                        >
                            <i class="fa-solid fa-list"></i>
                        </button>
                        <button
                            id="userViewGridBtn"
                            type="button"
                            class="theme-btn-secondary px-4 py-2"
                            aria-label="Toon rasterweergave"
                            aria-pressed="false"
                        >
                            <i class="fa-solid fa-grid-2"></i>
                        </button>
                    </div>
                    <div class="theme-surface theme-pill border theme-border px-4 py-2">
                        <p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Totaal</p>
                        <p class="text-xl font-black theme-text-primary"><%= userCount %></p>
                    </div>
                    <a href="/admin/users/new" class="theme-btn-primary px-4 py-2" aria-label="Gebruiker toevoegen">
                        <i class="fas fa-add"></i>
                    </a>
                </div>

                <% if (userCount === 0) { %>
                    <article class="theme-panel p-8 md:p-10 text-center">
                        <h2 class="text-xl font-extrabold theme-text-primary">Nog geen gebruikers gevonden</h2>
                        <p class="theme-subtext">Zodra iemand een account aanmaakt, verschijnt die persoon hier automatisch.</p>
                    </article>
                <% } else { %>
                    <div class="theme-panel overflow-hidden">
                        <ul id="userCollection" class="divide-y theme-border-soft">
                        <% userEntries.forEach(([userId, userData]) => {
                            const profile = userData || {}
                            const fullName = profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
                            const firstInitial = profile?.name?.first?.charAt(0) || fullName.charAt(0) || ''
                            const lastInitial = profile?.name?.last?.charAt(0) || fullName.split(' ')[1]?.charAt(0) || ''
                            const initials = `${firstInitial}${lastInitial}`.toUpperCase() || 'RG'
                            const email = profile?.email || 'Geen e-mail'
                            const city = profile?.address?.city || 'Onbekend'
                        %>
                            <li data-user-item class="p-4 md:p-5">
                                <div data-user-row class="flex items-center gap-3 md:gap-4">
                                    <% if (profile?.photoURL) { %>
                                        <img src="<%= profile.photoURL %>" alt="Profielfoto van <%= fullName %>" class="theme-avatar h-14 w-14 object-cover rounded-full">
                                    <% } else { %>
                                        <div class="theme-avatar h-14 w-14 flex items-center justify-center text-sm font-black rounded-full">
                                            <%= initials %>
                                        </div>
                                    <% } %>

                                    <div class="min-w-0 flex-1">
                                        <h2 class="theme-text-primary text-base md:text-lg font-bold leading-tight truncate"><%= fullName %></h2>
                                        <div data-user-meta class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs md:text-sm">
                                            <p class="theme-text-muted">E-mail: <span class="theme-text-primary"><%= email %></span></p>
                                            <p class="theme-text-muted">Stad: <span class="theme-text-primary"><%= city %></span></p>
                                            <p class="theme-text-muted">UID: <span class="theme-text-primary font-mono"><%= userId %></span></p>
                                        </div>
                                    </div>

                                    <a
                                        data-user-action
                                        href="/admin/users/<%= encodeURIComponent(userId) %>"
                                        class="theme-btn-secondary px-3 py-2 text-sm shrink-0"
                                    >
                                        Bewerken
                                    </a>
                                </div>

                            </li>
                        <% }) %>
                        </ul>
                    </div>
                <% } %>
            </section>
        </main>

        <script>
            (() => {
                const listBtn = document.getElementById('userViewListBtn')
                const gridBtn = document.getElementById('userViewGridBtn')
                const collection = document.getElementById('userCollection')

                if (!listBtn || !gridBtn || !collection) {
                    return
                }

                const storageKey = 'ritje_admin_users_view'

                const applyView = (view) => {
                    const isGrid = view === 'grid'

                    collection.className = isGrid
                        ? 'grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-5 p-4 md:p-5'
                        : 'divide-y theme-border-soft'

                    collection.querySelectorAll('[data-user-item]').forEach((item) => {
                        item.className = isGrid
                            ? 'theme-surface theme-pill border theme-border p-4 md:p-5'
                            : 'p-4 md:p-5'
                    })

                    collection.querySelectorAll('[data-user-row]').forEach((row) => {
                        row.className = isGrid
                            ? 'flex flex-col items-start gap-4'
                            : 'flex items-center gap-3 md:gap-4'
                    })

                    collection.querySelectorAll('[data-user-meta]').forEach((meta) => {
                        meta.className = isGrid
                            ? 'mt-1 flex flex-col gap-1 text-xs md:text-sm'
                            : 'mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs md:text-sm'
                    })

                    collection.querySelectorAll('[data-user-action]').forEach((action) => {
                        action.className = isGrid
                            ? 'theme-btn-secondary px-3 py-2 text-sm w-full text-center'
                            : 'theme-btn-secondary px-3 py-2 text-sm shrink-0'
                    })

                    listBtn.className = isGrid
                        ? 'theme-btn-secondary px-4 py-2'
                        : 'theme-btn-primary px-4 py-2'
                    gridBtn.className = isGrid
                        ? 'theme-btn-primary px-4 py-2'
                        : 'theme-btn-secondary px-4 py-2'

                    listBtn.setAttribute('aria-pressed', String(!isGrid))
                    gridBtn.setAttribute('aria-pressed', String(isGrid))

                    window.localStorage.setItem(storageKey, isGrid ? 'grid' : 'list')
                }

                listBtn.addEventListener('click', () => applyView('list'))
                gridBtn.addEventListener('click', () => applyView('grid'))

                const savedView = window.localStorage.getItem(storageKey)
                applyView(savedView === 'grid' ? 'grid' : 'list')
            })()
        </script>

        <%- include('partials/footer') %>
    </body>
</html>
