<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
    <%- include('partials/head', { title }) %>

    <%
        const userEntries = Object.entries(users || {})
        const userCount = userEntries.length
    %>

    <body class="theme-body min-h-screen flex flex-col">
        <%- include('partials/header', { user }) %>
        <main class="theme-main flex-1 pt-0!">
            <%- include('partials/admin_nav', { selected: { users: true } }) %>

            <section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10">
                <div class="mb-8 md:mb-10 flex mx-auto w-xl justify-center gap-3">
                    <div class="theme-surface theme-pill border theme-border px-4 py-2">
                        <p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Totaal</p>
                        <p class="text-xl font-black theme-text-primary"><%= userCount %></p>
                    </div>
                    <a href="/admin/users/new" class="theme-btn-primary p-2 aspect-square w-15.5" aria-label="Gebruiker toevoegen">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>

                <div class="grid sm:grid-cols-1 lg:grid-cols-4 gap-3 mb-8 md:mb-10">
                    <div class="theme-panel p-4 md:p-5 lg:col-span-3">
                        <label for="usersSearch" class="block text-sm font-semibold theme-text-primary">Zoeken</label>
                        <input id="usersSearch" type="search" placeholder="Zoek op naam, stad, e-mail of UID..." class="theme-input mt-3 w-full" />
                    </div>
                    <div class="theme-panel p-4 md:p-5 lg:col-span-1">
                        <label for="sortSelect" class="block text-sm font-semibold theme-text-primary">Sorteer op</label>
                        <select id="sortSelect" class="theme-input mt-3 w-full cursor-pointer" aria-label="Sorteer gebruikers">
                            <option value="name">Naam (A-Z)</option>
                            <option value="name_reverse">Naam (Z-A)</option>
                            <option value="city">Stad (A-Z)</option>
                            <option value="city_reverse">Stad (Z-A)</option>
                        </select>
                    </div>
                </div>

                <% if (userCount === 0) { %>
                    <article class="theme-panel p-8 md:p-10 text-center">
                        <h2 class="text-xl font-extrabold theme-text-primary">Nog geen gebruikers gevonden</h2>
                        <p class="theme-subtext">Zodra iemand een account aanmaakt, verschijnt die persoon hier automatisch.</p>
                    </article>
                <% } else { %>
                    <div class="theme-panel overflow-hidden">
                        <ul id="userCollection" class="divide-y theme-border-soft">
                        <% userEntries.forEach(([userId, userData]) => {
                            const profile = userData || {}
                            const fullName = profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
                            const firstInitial = profile?.name?.first?.charAt(0) || fullName.charAt(0) || ''
                            const lastInitial = profile?.name?.last?.charAt(0) || fullName.split(' ')[1]?.charAt(0) || ''
                            const initials = `${firstInitial}${lastInitial}`.toUpperCase() || 'RG'
                            const city = profile?.address?.city || 'Onbekend'
                            const email = profile?.email || 'Geen e-mail'
                        %>
                            <li
                                data-user-item
                                data-sort-name="<%= fullName.toLocaleLowerCase('nl-BE') %>"
                                data-sort-city="<%= city.toLocaleLowerCase('nl-BE') %>"
                                class="p-4 md:p-5"
                            >
                                <div data-user-row class="flex items-center gap-3 md:gap-4">
                                    <% if (profile?.photoURL) { %>
                                        <img src="<%= profile.photoURL %>" alt="Profielfoto van <%= fullName %>" class="theme-avatar h-14 w-14 object-cover rounded-full">
                                    <% } else { %>
                                        <div class="theme-avatar h-14 w-14 flex items-center justify-center text-sm font-black rounded-full">
                                            <%= initials %>
                                        </div>
                                    <% } %>

                                    <div class="min-w-0 flex-1">
                                        <h2 class="theme-text-primary text-base md:text-lg font-bold leading-tight truncate"><%= fullName %></h2>
                                        <div data-user-meta class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs md:text-sm">
                                            <p class="theme-text-muted">Stad: <span class="theme-text-primary"><%= city %></span></p>
                                            <p class="theme-text-muted">E-mail: <span class="theme-text-primary"><%= email %></span></p>
                                            <p class="theme-text-muted">UID: <span class="theme-text-primary font-mono"><%= userId %></span></p>
                                        </div>
                                    </div>

                                    <a
                                        data-user-action
                                        href="/admin/users/<%= encodeURIComponent(userId) %>"
                                        class="theme-btn-secondary px-3 py-2 text-sm shrink-0"
                                    >
                                        Bekijken
                                    </a>
                                </div>

                            </li>
                        <% }) %>
                        </ul>
                    </div>
                <% } %>
            </section>
        </main>
        <script src="/js/admin_users_sort.js"></script>

        <%- include('partials/footer') %>
    </body>
</html>
