<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<% 
		const metadata = user?.metadata || {}
		const firstName = metadata?.name?.first || ''
		const lastName = metadata?.name?.last || ''
		const fullName = `${metadata?.name?.full || ''}`.trim() || 'Ritje Gebruiker'
		const initials = fullName.split(' ').filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || 'A'

		const photoURL = user?.photoURL || null
		const phoneNumber = user?.phoneNumber || ''
		const joinedDate = user?.createdAt ? new Date(user.createdAt).toLocaleString('nl-BE', { 
			year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' 
		}) : 'Onbekend';

		const lastSignInDate = user?.lastSignInTime ? new Date(user.lastSignInTime).toLocaleString('nl-BE', { 
			year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' 
		}) : 'Onbekend';		const address = metadata?.address || {}
		const coords = metadata?.coords || {}
		const street = address?.street || ''
		const houseNumber = address?.houseNumber || ''
		const postalCode = address?.postalCode || ''
		const city = address?.city || ''
		const hasCoordinates = Boolean(coords?.latitude && coords?.longitude)
		const safeAddressLineOne = `${street} ${houseNumber}`.trim() || '-'
		const safeAddressLineTwo = `${postalCode} ${city}`.trim() || '-'
		const mapsUrl = hasCoordinates ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(safeAddressLineOne + ', ' + safeAddressLineTwo)}` : null;		const scheduleDays = []
	%>
	<%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>

		<main class="theme-main flex-1">
			<section class="max-w-5xl mx-auto">
				<div class="mb-8 md:mb-10 text-center">
					<p class="theme-kicker">Ritje Profiel</p>
					<h1 class="theme-heading">Welkom, <span class="theme-accent-text"><%= fullName %></span></h1>
					<p class="theme-subtext">Bekijk je accountgegevens en profielinformatie.</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-110">
						<div class="flex items-center gap-4">
							<% if (photoURL) { %>
								<img src="<%= photoURL %>" alt="Profielfoto van <%= fullName %>" class="theme-avatar h-16 w-16 object-cover rounded-full">
							<% } else { %>
								<div class="theme-avatar h-16 w-16 flex items-center justify-center text-xl font-black">
									<%= initials %>
								</div>
							<% } %>
							<div class="min-w-0">
								<p class="theme-text-primary text-lg font-bold leading-tight truncate"><%= fullName %></p>
								<p class="theme-text-muted text-sm truncate"><%= user?.email || 'Geen e-mail gevonden' %></p>
								<% if (phoneNumber) { %>
									<p class="theme-text-muted text-sm truncate"><%= phoneNumber %></p>
								<% } %>
							</div>
						</div>

						<div class="mt-6 border-t theme-border pt-5 space-y-3 text-sm flex-1">
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Gebruiker ID</span>
								<span class="theme-text-primary font-mono text-xs break-all text-right"><%= user?.uid || '-' %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Aangemaakt op</span>
								<span class="theme-text-primary"><%= joinedDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Laatst ingelogd</span>
								<span class="theme-text-primary"><%= lastSignInDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">E-mail bevestigd</span>
								<span class="<%= user?.email_verified ? 'text-emerald-300' : 'text-amber-300' %>">
									<%= user?.email_verified ? 'Ja' : 'Nee' %>
								</span>
							</div>
						</div>

						<div class="mt-4 pt-3 grid grid-cols-2 gap-3">
							<% if (user?.isAdmin) { %>
								<a href="/admin" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center col-span-2">Admin Panel</a>
							<% } %>
							<a href="/profile/edit" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Bewerken</a>
							<form action="/logout" method="post" class="w-full">
								<button type="submit" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center cursor-pointer">Uitloggen</button>
							</form>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
						<p class="theme-text-muted text-sm mt-1">Overzicht van je account en adresinformatie.</p>

						<div class="mt-6 space-y-4">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= firstName || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= lastName || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</p>
									<p class="theme-text-primary font-semibold mt-1"><%= street || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 md:col-span-1">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</p>
									<p class="theme-text-primary font-semibold mt-1"><%= houseNumber || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</p>
									<p class="theme-text-primary font-semibold mt-1"><%= postalCode || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</p>
									<p class="theme-text-primary font-semibold mt-1"><%= city || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Latitude</p>
									<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? metadata?.coords?.latitude : '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Longitude</p>
									<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? metadata?.coords?.longitude : '-' %></p>
								</div>
							</div>
							<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
								<div class="flex items-start justify-between gap-3">
									<div>
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Kaart</p>
										<p class="mt-1 text-sm theme-text-muted">Bekijk je opgegeven locatie op de kaart.</p>
									</div>
									<% if (mapsUrl) { %>
										<a
											href="<%= mapsUrl %>"
											target="_blank"
											rel="noopener noreferrer"
											class="theme-link text-xs whitespace-nowrap mt-0.5"
										>
											Google Maps
										</a>
									<% } %>
								</div>
								<details class="profile-map-details mt-3">
									<summary class="profile-map-summary theme-pill border theme-border theme-surface-strong px-3 py-2">
										<span class="font-semibold theme-text-primary">Toon kaart</span>
										<span class="profile-map-chevron" aria-hidden="true">v</span>
									</summary>
									<div class="profile-map-panel mt-3 overflow-hidden theme-pill border theme-border">
										<div
											id="map"
											class="w-full h-64"
											data-latitude="<%= metadata?.coords?.latitude || '' %>"
											data-longitude="<%= metadata?.coords?.longitude || '' %>"
											data-full-name="<%= fullName %>"
											data-address-line-one="<%= safeAddressLineOne %>"
											data-address-line-two="<%= safeAddressLineTwo %>"
											data-maps-url="<%= mapsUrl || '' %>"
										></div>
									</div>
								</details>
							</div>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2 lg:col-start-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Urenrooster</h2>
						<p class="theme-text-muted text-sm mt-1">
							Bekijk je huidige urenrooster per dag. Dit helpt collega's om ritten te plannen.
						</p>

						<div class="mt-6 grid grid-cols-1 md:grid-cols-3 md:col-width-auto gap-4">
							<% scheduleDays.forEach((day) => {
								const daySchedule = weeklySchedule?.[day.key] || null
								const hasHours = Boolean(daySchedule?.start && daySchedule?.end)
							%>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted"><%= day.label %></p>
									<p class="theme-text-primary font-semibold mt-1"><%= hasHours ? `${daySchedule.start} - ${daySchedule.end}` : 'Geen uren ingesteld' %></p>
								</div>
							<% }) %>
						</div>
					</article>
				</div>
			</section>
		</main>

		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
		<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
		<script src="/js/profile_map.js"></script>
		<%- include('partials/footer') %>
	</body>
</html>
