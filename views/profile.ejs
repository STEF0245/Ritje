<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%
		const metadata = user?.user_metadata || {}
		const appMetadata = user?.app_metadata || {}
		const fullName =
			metadata?.full_name ||
			metadata?.display_name ||
			[metadata?.first_name, metadata?.last_name]
				.filter(Boolean)
				.join(' ') ||
			'user'
		const initials =
			fullName
				.split(' ')
				.filter(Boolean)
				.slice(0, 2)
				.map((part) => part[0]?.toUpperCase())
				.join('') || 'U'
		const joinedDate = user?.created_at
			? new Date(user.created_at).toLocaleString('nl-Be', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
			})
			: 'Onbekend'
		const lastSignInDate = user?.last_sign_in_at
			? new Date(user.last_sign_in_at).toLocaleDateString('nl-BE', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
			})
			: 'Onbekend'
		const updatedDate = user?.updated_at
			? new Date(user.updated_at).toLocaleDateString('nl-BE', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit'
			})
			: 'Onbekend'
		const hasCoordinates =
			metadata?.latitude != undefined &&
			metadata?.latitude != null &&
			metadata?.latitude !== '' &&
			metadata?.longitude != undefined &&
			metadata?.longitude != null &&
			metadata?.longitude !== ''
		const mapsUrl = hasCoordinates
			? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
				`${metadata.street} ${metadata.house_number}, ${metadata.postal_code} ${metadata.city}, ${metadata.country}`
			)}`
			: null
	%>
	<%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>

		<main class="theme-main flex-1">
			<section class="max-w-5xl mx-auto">
				<div class="mb-8 md:mb-10 text-center">
					<p class="theme-kicker">Ritje Profiel</p>
					<h1 class="theme-heading">
						Welkom, <span class="theme-accent-text"><%= fullName %></span>
					</h1>
					<p class="theme-subtext">Bekijk je accountgegevens en profielinformatie.</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col">
						<div class="flex items-center gap-4">
							<div class="theme-avatar h-16 w-16 flex items-center justify-center text-xl font-black">
								<%= initials %>
							</div>
							<div>
								<p class="text-white text-lg font-bold leading-tight"><%= fullName %></p>
								<p class="text-slate-400 text-sm"><%= user?.email || 'Geen e-mail gevonden' %></p>
								<%- user?.phone ? `<p class="text-slate-400 text-sm">${user.phone}</p>` : '' %>
							</div>
						</div>

						<div class="mt-6 border-t border-slate-700/70 pt-5 space-y-3 flex flex-col text-sm flex-1">
							<div class="flex items-center justify-between gap-4">
								<span class="text-slate-400">Gebruiker ID</span>
								<span class="text-slate-100 font-mono text-xs break-all text-right"><%= user?.id || '-' %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="text-slate-400">Aangemaakt op</span>
								<span class="text-slate-100"><%= joinedDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="text-slate-400">Laatst ingelogd</span>
								<span class="text-slate-100"><%= lastSignInDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="text-slate-400">Laatst bijgewerkt</span>
								<span class="text-slate-100"><%= updatedDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="text-slate-400">E-mail bevestigd</span>
								<span class="<%= user?.email_confirmed_at ? 'text-emerald-300' : 'text-amber-300' %>">
									<%= user?.email_confirmed_at ? 'Ja' : 'Nee' %>
								</span>
							</div>
							<div class="mt-auto pt-3 flex flex-row gap-3">
								<a href="/profile/edit" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Bewerken</a>
                                <a href="/auth/logout" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Uitloggen</a>
							</div>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold text-white">Profielgegevens</h2>
						<p class="text-slate-400 text-sm mt-1">Overzicht van je account en adresinformatie.</p>

						<div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
							<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4">
								<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Voornaam</p>
								<p class="text-white font-semibold mt-1"><%= metadata?.first_name || '-' %></p>
							</div>
							<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4">
								<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Achternaam</p>
								<p class="text-white font-semibold mt-1"><%= metadata?.last_name || '-' %></p>
							</div>
							<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4 md:col-span-2">
								<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Adres</p>
								<p class="text-white font-semibold mt-1"><%= metadata?.address || '-' %></p>
							</div>
							<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4">
								<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Latitude</p>
								<p class="text-white font-semibold mt-1"><%= hasCoordinates ? metadata?.latitude : '-' %></p>
							</div>
							<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4">
								<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Longitude</p>
								<p class="text-white font-semibold mt-1"><%= hasCoordinates ? metadata?.longitude : '-' %></p>
							</div>
							<% if (mapsUrl) { %>
								<div class="rounded-xl border border-slate-700/70 bg-slate-900/50 p-4 md:col-span-2">
									<p class="text-xs uppercase tracking-[0.12em] text-slate-400">Kaart</p>
									<a
										href="<%= mapsUrl %>"
										target="_blank"
										rel="noopener noreferrer"
										class="theme-link inline-block mt-1"
									>
										Open locatie in Google Maps
									</a>
								</div>
							<% } %>
							</div>
						</div>
					</article>
				</div>
			</section>
		</main>

		<%- include('partials/footer') %>
	</body>
</html>
