<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%
		const metadata = user?.user_metadata || {}
		const appMetadata = user?.app_metadata || {}
		const isEditing = Boolean(locals.isEditMode)
		const firstName = metadata?.first_name || ''
		const lastName = metadata?.last_name || ''
		const fullName =
			metadata?.full_name ||
			metadata?.display_name ||
			[firstName, lastName].filter(Boolean).join(' ') ||
			'user'
		const initials =
			fullName
				.split(' ')
				.filter(Boolean)
				.slice(0, 2)
				.map((part) => part[0]?.toUpperCase())
				.join('') || 'U'
		const joinedDate = user?.created_at
			? new Date(user.created_at).toLocaleString('nl-BE', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit'
			})
			: 'Onbekend'
		const lastSignInDate = user?.last_sign_in_at
			? new Date(user.last_sign_in_at).toLocaleString('nl-BE', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit'
			})
			: 'Onbekend'
		const updatedDate = user?.updated_at
			? new Date(user.updated_at).toLocaleString('nl-BE', {
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
				hour: '2-digit',
				minute: '2-digit'
			})
			: 'Onbekend'
		const street = metadata?.street || ''
		const houseNumber = metadata?.house_number || ''
		const postalCode = metadata?.postal_code || ''
		const city = metadata?.city || ''
		const country = metadata?.country || 'Belgium'
		const hasCoordinates =
			metadata?.latitude !== undefined &&
			metadata?.latitude !== null &&
			metadata?.latitude !== '' &&
			metadata?.longitude !== undefined &&
			metadata?.longitude !== null &&
			metadata?.longitude !== ''
		const mapsAddress = [
			`${street} ${houseNumber}`.trim(),
			`${postalCode} ${city}`.trim(),
			country
		]
			.filter(Boolean)
			.join(', ')
		const mapsUrl =
			hasCoordinates && mapsAddress
				? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsAddress)}`
				: null
	%>
	<%- include('partials/head', { title }) %>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>

		<main class="theme-main flex-1">
			<section class="max-w-5xl mx-auto">
				<div class="mb-8 md:mb-10 text-center">
					<p class="theme-kicker">Ritje Profiel</p>
					<h1 class="theme-heading">
						<%= isEditing ? 'Bewerk je profiel' : 'Welkom,' %>
						<span class="theme-accent-text"><%= fullName %></span>
					</h1>
					<p class="theme-subtext">
						<%= isEditing
							? 'Pas je gegevens aan. Coördinaten worden automatisch bijgewerkt op basis van je adres.'
							: 'Bekijk je accountgegevens en profielinformatie.' %>
					</p>
				</div>

				<% if (authErrorReason) { %>
					<%- include('partials/notify', { authErrorReason, authErrorType }) %>
				<% } %>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col">
						<div class="flex items-center gap-4">
							<div class="theme-avatar h-16 w-16 flex items-center justify-center text-xl font-black">
								<%= initials %>
							</div>
							<div>
								<p class="theme-text-primary text-lg font-bold leading-tight"><%= fullName %></p>
								<p class="theme-text-muted text-sm"><%= user?.email || 'Geen e-mail gevonden' %></p>
								<%- user?.phone ? `<p class="theme-text-muted text-sm">${user.phone}</p>` : '' %>
							</div>
						</div>

						<div class="mt-6 border-t theme-border pt-5 space-y-3 text-sm flex-1">
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Gebruiker ID</span>
								<span class="theme-text-primary font-mono text-xs break-all text-right"><%= user?.id || '-' %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Aangemaakt op</span>
								<span class="theme-text-primary"><%= joinedDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Laatst ingelogd</span>
								<span class="theme-text-primary"><%= lastSignInDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">Laatst bijgewerkt</span>
								<span class="theme-text-primary"><%= updatedDate %></span>
							</div>
							<div class="flex items-center justify-between gap-4">
								<span class="theme-text-muted">E-mail bevestigd</span>
								<span class="<%= user?.email_confirmed_at ? 'text-emerald-300' : 'text-amber-300' %>">
									<%= user?.email_confirmed_at ? 'Ja' : 'Nee' %>
								</span>
							</div>
						</div>

						<div class="mt-4 pt-3 flex flex-row gap-3">
							<% if (isEditing) { %>
								<a href="/profile" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Annuleren</a>
							<% } else { %>
								<a href="/profile/edit" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Bewerken</a>
							<% } %>
							<a href="/auth/logout" class="theme-pill border theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Uitloggen</a>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">
							<%= isEditing ? 'Profiel bewerken' : 'Profielgegevens' %>
						</h2>
						<p class="theme-text-muted text-sm mt-1">
							<%= isEditing
								? 'Pas je naam en adres aan. Coördinaten worden automatisch ingevuld via forward geocoding.'
								: 'Overzicht van je account en adresinformatie.' %>
						</p>

						<% if (isEditing) { %>
							<form action="/profile/edit" method="post" id="profile-edit-form" class="mt-6 space-y-4">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="first_name" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Voornaam</label>
										<input type="text" name="first_name" id="first_name" class="theme-text-primary font-semibold mt-1 w-full" value="<%= firstName %>" required />
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="last_name" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Achternaam</label>
										<input type="text" name="last_name" id="last_name" class="theme-text-primary font-semibold mt-1 w-full" value="<%= lastName %>" required />
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
										<label for="street" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Straat</label>
										<input type="text" name="street" id="street" class="theme-text-primary font-semibold mt-1 w-full" value="<%= street %>" required />
									</div>
									<div class="theme-surface theme-pill border theme-border p-4 md:col-span-1">
										<label for="house_number" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Nummer</label>
										<input type="text" name="house_number" id="house_number" class="theme-text-primary font-semibold mt-1 w-full" value="<%= houseNumber %>" required />
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="postal_code" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Postcode</label>
										<input type="text" name="postal_code" id="postal_code" class="theme-text-primary font-semibold mt-1 w-full" value="<%= postalCode %>" required />
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="city" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Stad</label>
										<input type="text" name="city" id="city" class="theme-text-primary font-semibold mt-1 w-full" value="<%= city %>" required />
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="latitude" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Latitude (auto)</label>
										<input type="text" name="latitude_preview" id="latitude" class="theme-text-primary font-semibold mt-1 w-full" value="<%= metadata?.latitude || '' %>" readonly />
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<label for="longitude" class="text-xs uppercase tracking-[0.12em] theme-text-muted block">Longitude (auto)</label>
										<input type="text" name="longitude_preview" id="longitude" class="theme-text-primary font-semibold mt-1 w-full" value="<%= metadata?.longitude || '' %>" readonly />
									</div>
								</div>

								<p id="profile-geocode-status" class="text-xs theme-text-muted"></p>

								<input type="hidden" name="country" value="Belgium" />
								<input type="hidden" name="address" id="address" value="<%= metadata?.address || '' %>" />

								<div class="pt-2 flex justify-end">
									<button type="submit" class="theme-btn-primary px-5 py-3 cursor-pointer">Opslaan</button>
								</div>
							</form>
						<% } else { %>
							<div class="mt-6 space-y-4">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</p>
										<p class="theme-text-primary font-semibold mt-1"><%= firstName || '-' %></p>
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</p>
										<p class="theme-text-primary font-semibold mt-1"><%= lastName || '-' %></p>
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</p>
										<p class="theme-text-primary font-semibold mt-1"><%= street || '-' %></p>
									</div>
									<div class="theme-surface theme-pill border theme-border p-4 md:col-span-1">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</p>
										<p class="theme-text-primary font-semibold mt-1"><%= houseNumber || '-' %></p>
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</p>
										<p class="theme-text-primary font-semibold mt-1"><%= postalCode || '-' %></p>
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</p>
										<p class="theme-text-primary font-semibold mt-1"><%= city || '-' %></p>
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Latitude</p>
										<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? metadata?.latitude : '-' %></p>
									</div>
									<div class="theme-surface theme-pill border theme-border p-4">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Longitude</p>
										<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? metadata?.longitude : '-' %></p>
									</div>
								</div>
								<% if (mapsUrl) { %>
									<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Kaart</p>
										<a href="<%= mapsUrl %>" target="_blank" rel="noopener noreferrer" class="theme-link inline-block mt-1">Open locatie in Google Maps</a>
									</div>
								<% } %>
							</div>
						<% } %>
					</article>
				</div>
			</section>
		</main>

		<% if (isEditing) { %>
			<script src="/js/profile_edit.js"></script>
		<% } %>
		<%- include('partials/footer') %>
	</body>
</html>
