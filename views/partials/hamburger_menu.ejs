<button
	class="md:hidden flex items-center justify-start justify-self-end rounded-full border border-slate-700/80 bg-slate-900/80 p-2 text-slate-200 transition hover:border-blue-400 hover:cursor-pointer w-fit"
	aria-label="Menu"
	onclick="
		document.getElementById('mobile-menu').classList.toggle('hidden')
	"
>
	<svg
		class="h-6 w-6"
		fill="none"
		viewBox="0 0 24 24"
		stroke="currentColor"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M4 6h16M4 12h16M4 18h16"
		/>
	</svg>
</button>

<div
    id="mobile-menu"
    class="hidden absolute top-full right-0 w-fit bg-slate-900 border border-slate-800 rounded-md mt-2 mr-4 py-4 px-6 space-y-4 z-50"
>
    <div class="flex flex-col space-y-4">
        <%- include('header_link', { url: '/about', text: 'Over Ons' }) %>
        <%- include('header_link', { url: '/dashboard', text: 'Dashboard' }) %>
        <%- include('header_link', { url: '/ride/offer', text: 'Rit Aanbieden' }) %>
    </div>

    <div class="border-t border-slate-800 mt-4 pt-4">
        <%- include('profile_menu', { user }) %>
    </div>
</div>