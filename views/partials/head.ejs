<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title><%= title %> | Ritje</title>
	<link rel="icon" href="/favicon.ico" />
	<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
	<link rel="stylesheet" href="/css/style.css" />
	<link rel="stylesheet" href="/FontAwesome/css/all.css" />
	<%
		const sessionUser = locals.user || null
		const sessionPayload = {
			user: sessionUser,
			idToken: sessionUser?.idToken || null
		}
		const serializedSession = JSON.stringify(sessionPayload).replace(/</g, '\\u003c')
	%>
	<script>
		window.__RITJE_SESSION__ = <%- serializedSession %>
	</script>

	<%- locals.extraElements ? locals.extraElements : '' %>
</head>
