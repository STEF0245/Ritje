
<%
    const selected = locals.selected || {}
    const navItems = [
        { url: '/admin/dashboard', text: 'Dashboard', active: selected.dashboard },
        { url: '/admin/users', text: 'Users', active: selected.users },
        { url: '/admin/settings', text: 'Settings', active: selected.settings },
    ]
%>

<aside class="w-full lg:w-72 lg:sticky lg:top-24 lg:self-start" aria-label="Admin navigatie">
	<div class="theme-panel p-3 md:p-4">
		<p class="theme-kicker px-1 pb-3">Admin menu</p>
		<nav class="grid grid-cols-1 gap-2" aria-label="Admin navigatie">
			<% navItems.forEach((item) => { %>
				<a
					href="<%= item.url %>"
					class="theme-pill border px-4 py-3 text-sm font-semibold tracking-wide transition-colors text-center lg:text-left <%= item.active ? 'theme-surface-strong theme-text-primary theme-hover-accent-border' : 'theme-surface theme-text-muted theme-hover-accent-border' %>"
					aria-current="<%= item.active ? 'page' : '' %>"
				>
					<%= item.text %>
				</a>
			<% }) %>
		</nav>
	</div>
</aside>