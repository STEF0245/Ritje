<% if (locals?.main) { %>
    <a href="<%= url %>" class="ride-accent text-white px-6 py-2.5 rounded-full text-sm font-bold transition hover:brightness-110">
        <%= text %>
    </a>
<% } else { %>
    <a href="<%= url %>" class="hover:text-blue-300 transition">
        <%= text %>
    </a>
<% } %>