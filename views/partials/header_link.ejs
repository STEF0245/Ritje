<%# @file Shared navigation link partial for header and admin menus. %>

<% if (locals?.selected) { %>
    <a href="<%= url %>" class="theme-link theme-accent-text font-bold">
        <%= text %>
    </a>
<% } else { %>
    <a href="<%= url %>" class="theme-link">
        <%= text %>
    </a>
<% } %>