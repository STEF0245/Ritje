<% if (pageError?.message) { %>
	<section class="max-w-7xl mx-auto px-6 mt-4" role="alert" aria-live="assertive">
		<div class="theme-pill border border-rose-500/40 bg-rose-500/10 px-4 py-3">
			<p class="text-xs uppercase tracking-[0.12em] text-rose-200">Fout <%= pageError.status || 500 %></p>
			<p class="mt-1 text-sm text-rose-100"><%= pageError.message %></p>
		</div>
	</section>
<% } %>
