
<%
	const notifications = Array.isArray(locals.notifications)
		? locals.notifications
		: []
%>

<% if (notifications.length > 0) { %>
	<section
		data-notification-root
		class="fixed top-24 right-4 md:right-6 z-60 w-[calc(100vw-2rem)] max-w-md space-y-3 pointer-events-none"
		role="status"
		aria-live="polite"
	>
		<% for (const item of notifications) { %>
			<%
				const type = item?.type || 'info'
				const label = item?.label || null
				const message = item?.message || ''
				const tones = {
					success: {
						label: 'Succes',
						classes:
							'border-emerald-400/70 bg-emerald-500/18 text-emerald-100'
					},
					warning: {
						label: 'Waarschuwing',
						classes:
							'border-amber-400/70 bg-amber-500/18 text-amber-100'
					},
					error: {
						label: 'Fout',
						classes:
							'border-rose-400/70 bg-rose-500/18 text-rose-100'
					},
					info: {
						label: 'Info',
						classes:
							'border-sky-400/70 bg-sky-500/18 text-sky-100'
					}
				}
				const tone = tones[type] || tones.info
				const resolvedLabel = label || tone.label
			%>

			<article class="theme-pill border px-4 py-3 pointer-events-auto shadow-2xl z-50 backdrop-blur-md bg-linear-to-br from-slate-900/80 to-slate-800/75 <%= tone.classes %>">
				<div class="flex items-center justify-between gap-4">
					<p class="text-xs uppercase tracking-[0.14em] font-bold"><%= resolvedLabel %></p>
					<button type="button" aria-label="Melding sluiten" class="cursor-pointer text-current/80 hover:text-current transition-colors">
						<i class="fas fa-times"></i>
					</button>
				</div>
				<% if (message) { %>
					<p class="mt-2 text-sm normal-case tracking-normal leading-5 text-slate-100/95"><%= message %></p>
				<% } %>
				<script>
					const btn = document.currentScript.parentElement.querySelector('button')
					btn.addEventListener('click', () => {
						btn.parentElement.parentElement.remove()

						const root = document.querySelector('[data-notification-root]')
						const remaining = root ? root.querySelectorAll(':scope > article') : []
						if (remaining.length === 0) {
							root.remove()
						}
					})
				</script>
			</article>
		<% } %>
	</section>
<% } %>
