<%
	const displayName =
		user?.user_metadata?.full_name ||
		user?.user_metadata?.name ||
		user?.email ||
		'Account'
	const initials = displayName
		.split(' ')
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase())
		.join('') || 'A'
%>

<div class="flex items-center gap-3 text-sm font-medium justify-end">
	<% if (user) { %>
		<a
			href="/profile"
			class="hidden md:flex items-center gap-3 theme-pill border border-slate-700/80 bg-slate-900/80 px-3 py-2 text-slate-100 transition hover:border-blue-400"
		>
			<span class="theme-avatar flex h-9 w-9 items-center justify-center text-xs font-black">
				<%= initials %>
			</span>
			<span class="max-w-40 truncate"><%= displayName %></span>
		</a>

		<a
			href='/profile'
			class="md:hidden theme-pill flex h-11 w-11 items-center justify-center border border-slate-700/80 bg-slate-900/80 text-xs font-black text-slate-100 transition hover:border-blue-400"
			aria-label="Ga naar je profiel"
			title="<%= displayName %>"
		>
			<%= initials %>
		</a>

		<a
			href='/auth/logout'
			class="theme-btn-secondary px-4 py-2.5 hover:border-rose-400"
		>
			Uitloggen
		</a>
	<% } else { %>
		<a
			href='/auth/login'
			class="theme-btn-secondary px-4 py-2.5"
		>
			Inloggen
		</a>

		<a
			href='/auth/register'
			class="theme-btn-primary px-5 py-2.5"
		>
			Registreren
		</a>
	<% } %>
</div>
