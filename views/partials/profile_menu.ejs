<%
	const displayName =
		user?.user_metadata?.full_name ||
		user?.user_metadata?.name ||
		user?.email ||
		'Account'
	const initials = displayName
		.split(' ')
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase())
		.join('') || 'A'
%>

<div class="flex items-center gap-3 text-sm font-medium justify-end">
	<% if (user) { %>
		<a
			href="/profile"
			class="hidden md:flex items-center gap-3 theme-pill border theme-border theme-surface px-3 py-2 theme-text-primary theme-hover-accent-border"
		>
			<span class="theme-avatar flex h-9 w-9 items-center justify-center text-xs font-black">
				<%= initials %>
			</span>
			<span class="max-w-40 truncate"><%= displayName %></span>
		</a>

		<a
			href='/profile'
			class="md:hidden theme-pill flex h-11 w-11 items-center justify-center border theme-border theme-surface text-xs font-black theme-text-primary theme-hover-accent-border"
			aria-label="Ga naar je profiel"
			title="<%= displayName %>"
		>
			<%= initials %>
		</a>
	<% } else { %>
		<a
			href='/login'
			class="theme-btn-primary px-4 py-2.5"
		>
			Inloggen
		</a>
	<% } %>
</div>
