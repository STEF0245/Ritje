<%
	const displayName = user?.displayName || user?.email || 'Account'
	const firstInitial = user?.name?.first?.charAt(0)?.toUpperCase() || ''
	const lastInitial = user?.name?.last?.charAt(0)?.toUpperCase() || ''
	const initials = `${firstInitial}${lastInitial}` || 'A'
%>

<div class="flex items-center gap-3 text-sm font-medium justify-end">
	<% if (user) { %>
		<a
			href="/profile"
			class="hidden md:flex items-center gap-3 rounded-xl border theme-border theme-surface pr-3 pl-2 py-2 theme-text-primary theme-hover-accent-border"
		>
			<% if (user?.photoURL) { %>
				<img
					src="<%= user.photoURL %>"
					alt="Avatar"
					class="theme-avatar h-9 w-9 object-cover"
				/>
			<% } else { %>
				<span class="theme-avatar flex h-9 w-9 items-center justify-center text-xs font-black">
					<%= initials %>
				</span>
			<% } %>
			<span class="max-w-40 truncate"><%= displayName %></span>
		</a>

		<a
			href='/profile'
			class="md:hidden flex items-center gap-3 theme-pill border theme-border theme-surface px-3 py-2 theme-text-primary theme-hover-accent-border"
			aria-label="Ga naar je profiel"
			title="<%= displayName %>"
		>
			<% if (user?.photoURL) { %>
				<img
					src="<%= user.photoURL %>"
					alt="Avatar"
					class="theme-avatar h-9 w-9 object-cover"
				/>
			<% } else { %>
				<span class="theme-avatar flex h-9 w-9 items-center justify-center text-xs font-black">
					<%= initials %>
				</span>
			<% } %>
			<span class="max-w-40 truncate"><%= displayName %></span>
		</a>
	<% } else { %>
		<a
			href='/login'
			class="theme-btn-primary px-4 py-2.5"
		>
			Inloggen
		</a>
	<% } %>
</div>
