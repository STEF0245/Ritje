<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%- include('partials/head', { title }) %>

	<%
		const profile = viewUser || {}
		const fullName =
			profile?.name?.full || profile?.displayName || 'Onbekende gebruiker'
		const firstInitial = profile?.name?.first?.charAt(0) || fullName.charAt(0) || ''
		const lastInitial =
			profile?.name?.last?.charAt(0) || fullName.split(' ')[1]?.charAt(0) || ''
		const initials = `${firstInitial}${lastInitial}`.toUpperCase() || 'RG'
		const email = profile?.email || ''
		const phoneNumber = profile?.phoneNumber || ''
		const address = profile?.address || {}
		const coords = profile?.coords || {}
		const street = address?.street || ''
		const houseNumber = address?.houseNumber || ''
		const postalCode = address?.postalCode || ''
		const city = address?.city || ''
		const hasCoordinates = Boolean(coords?.latitude && coords?.longitude)
		const photoURL = profile?.photoURL || ''
		const targetUid = userUid || '-'
		const createdAt = profile?.createdAt
			? new Date(profile.createdAt).toLocaleString('nl-BE', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
					hour: '2-digit',
					minute: '2-digit'
			})
			: 'Onbekend'
		const lastSignIn = profile?.lastSignInTime
			? new Date(profile.lastSignInTime).toLocaleString('nl-BE', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
					hour: '2-digit',
					minute: '2-digit'
			})
			: 'Onbekend'
		const isEmailVerified = Boolean(profile?.emailVerified)
		const safeAddressLineOne = `${street} ${houseNumber}`.trim() || '-'
		const safeAddressLineTwo = `${postalCode} ${city}`.trim() || '-'
		const mapsUrl = hasCoordinates ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(safeAddressLineOne + ', ' + safeAddressLineTwo)}` : null;
		const mapMarkers = hasCoordinates
			? [
					{
						latitude: coords?.latitude,
						longitude: coords?.longitude,
						title: fullName,
						lines: [safeAddressLineOne, safeAddressLineTwo],
						mapsUrl,
						openPopup: true
					}
			]
			: []
		const mapMarkersJson = JSON.stringify(mapMarkers)

		const schedule = profile?.schedule || {}
		const weekdays = [
			{ key: '1', label: 'Maandag' },
			{ key: '2', label: 'Dinsdag' },
			{ key: '3', label: 'Woensdag' },
			{ key: '4', label: 'Donderdag' },
			{ key: '5', label: 'Vrijdag' }
		]

		const resolveHourLabel = (hour, isStart) => {
			const hourMap = {
				'1': ['8:25', '9:15'],
				'2': ['9:15', '10:20'],
				'3': ['10:20', '11:10'],
				'4': ['11:10', '12:00'],
				'5': ['13:00', '13:50'],
				'6': ['13:50', '14:40'],
				'7': ['14:55', '15:45'],
				'8': ['15:45', '16:35']
			}
			if (!hour) return null
			const hourNumber = Number(hour)
			if (isNaN(hourNumber) || hourNumber < 1 || hourNumber > 8)
				return null
			const [start, end] = hourMap[hour] || []
			return isStart ? start : end
		}

		const normalizeHourNumber = (value) => {
			if (value === null || value === undefined) return null
			if (typeof value === 'string' && value.trim() === '') return null
			const numeric = Number(value)
			if (!Number.isInteger(numeric)) return null
			if (numeric >= 1 && numeric <= 8) return numeric
			if (numeric >= 0 && numeric <= 7) return numeric + 1
			return null
		}

		const getActiveHours = (hours) => {
			if (Array.isArray(hours)) {
				return hours
					.map((isActive, index) => (Boolean(isActive) ? String(index + 1) : null))
					.filter(Boolean)
			}
			if (hours && typeof hours === 'object') {
				if (
					Object.prototype.hasOwnProperty.call(hours, 'start') &&
					Object.prototype.hasOwnProperty.call(hours, 'end')
				) {
					const start = normalizeHourNumber(hours.start)
					const end = normalizeHourNumber(hours.end)
					if (!start || !end || end < start) return []
					return Array.from(
						{ length: end - start + 1 },
						(_, idx) => String(start + idx)
					)
				}

				return Object.entries(hours)
					.filter(([, isActive]) => Boolean(isActive))
					.map(([hour]) => normalizeHourNumber(hour))
					.filter((hour) => hour !== null)
					.map((hour) => String(hour))
					.filter((hour, index, list) => list.indexOf(hour) === index)
					.sort((a, b) => Number(a) - Number(b))
			}
			return []
		}

		const resolveDayHours = (dayKey) => {
			if (Object.prototype.hasOwnProperty.call(schedule, dayKey)) {
				return schedule[dayKey]
			}
			return null
		}
	%>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
		<main class="theme-main flex-1 pt-0!">
			<%- include('partials/admin_nav', { selected: { users: true } }) %>

			<section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10">
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<article class="theme-panel p-6 lg:col-span-1 h-full flex flex-col max-h-fit">
						<%- include('partials/user_summary_card', {
							avatarUrl: photoURL,
							initials,
							userName: fullName,
							email,
							phoneNumber,
							uid: targetUid,
							createdAt,
							lastSignIn,
							emailVerified: isEmailVerified || false,
						}) %>

						<div class="mt-4 pt-3 grid grid-cols-2 gap-3">
							<a href="/admin/users/<%= encodeURIComponent(targetUid) %>/edit" class="theme-pill border theme-btn-primary theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center col-span-2">Bewerken</a>
							<a href="/admin/users/<%= encodeURIComponent(targetUid) %>/delete" class="theme-pill border theme-btn-secondary theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Verwijderen</a>
							<a href="/admin/users" class="theme-pill border theme-btn-secondary theme-border theme-surface w-full px-3 py-2 theme-text-primary theme-hover-accent-border text-center">Overzicht</a>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Profielgegevens</h2>
						<p class="theme-text-muted text-sm mt-1">Overzicht van account- en adresgegevens.</p>

						<div class="mt-6 space-y-4">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Voornaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= profile?.name?.first || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Achternaam</p>
									<p class="theme-text-primary font-semibold mt-1"><%= profile?.name?.last || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Straat</p>
									<p class="theme-text-primary font-semibold mt-1"><%= street || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4 md:col-span-1">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Huisnummer</p>
									<p class="theme-text-primary font-semibold mt-1"><%= houseNumber || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Postcode</p>
									<p class="theme-text-primary font-semibold mt-1"><%= postalCode || '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Stad</p>
									<p class="theme-text-primary font-semibold mt-1"><%= city || '-' %></p>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Latitude</p>
									<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? coords?.latitude : '-' %></p>
								</div>
								<div class="theme-surface theme-pill border theme-border p-4">
									<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Longitude</p>
									<p class="theme-text-primary font-semibold mt-1"><%= hasCoordinates ? coords?.longitude : '-' %></p>
								</div>
							</div>

                            <div class="theme-surface theme-pill border theme-border p-4 md:col-span-2">
								<div class="flex items-start justify-between gap-3">
									<div>
										<p class="text-xs uppercase tracking-[0.12em] theme-text-muted">Kaart</p>
										<p class="mt-1 text-sm theme-text-muted">Bekijk de opgeslagen locatie op de kaart.</p>
									</div>
									<% if (mapsUrl) { %>
										<a
											href="<%= mapsUrl %>"
											target="_blank"
											rel="noopener noreferrer"
											class="theme-link text-xs whitespace-nowrap mt-0.5"
										>
											Google Maps
										</a>
									<% } %>
								</div>
								<details class="profile-map-details mt-3">
									<summary class="profile-map-summary theme-pill border theme-border theme-surface-strong px-3 py-2">
										<span class="font-semibold theme-text-primary">Toon kaart</span>
										<span class="profile-map-chevron" aria-hidden="true">v</span>
									</summary>
									<div class="profile-map-panel mt-3 overflow-hidden theme-pill border theme-border">
										<div
											data-map
											class="w-full h-64"
											data-latitude="<%= coords?.latitude || '' %>"
											data-longitude="<%= coords?.longitude || '' %>"
											data-markers="<%= mapMarkersJson %>"
										></div>
									</div>
								</details>
							</div>
						</div>
					</article>

					<article class="theme-panel p-6 lg:col-span-2 lg:col-start-2">
						<h2 class="text-xl font-extrabold theme-text-primary">Uurrooster</h2>
						<p class="theme-text-muted text-sm mt-1">Overzicht van je uurrooster.</p>

						<div class="mt-6 space-y-4">
							<%
								const hasAnySchedule = weekdays.some(({ key }) => {
									const dayHours = resolveDayHours(key)
									return getActiveHours(dayHours).length > 0
								})
							%>
							<% if (hasAnySchedule) { %>
								<div class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-4">
									<% weekdays.forEach(({ key, label }) => { %>
										<%
											const dayHours = resolveDayHours(key)
											const activeHours = getActiveHours(dayHours)
											const first = activeHours[0] || null
											const last = activeHours[activeHours.length - 1] || null
											const firstLabel = resolveHourLabel(first, true)
											const lastLabel = resolveHourLabel(last, false)
										%>
										<div class="theme-surface theme-pill border theme-border p-4">
											<p class="text-xs uppercase tracking-[0.12em] theme-text-muted"><%= label %></p>
											<p class="theme-text-primary font-semibold mt-1"><%= firstLabel && lastLabel ? `${firstLabel} - ${lastLabel}` : 'Niet beschikbaar' %></p>
										</div>
									<% }) %>
								</div>
							<% } else { %>
								<p class="theme-text-muted">Je hebt nog geen uurrooster ingesteld.</p>
							<% } %>
						</div>
					</article>

				</div>
			</section>
		</main>

		<%- include('partials/footer') %>
		<%- include('partials/map', {
            schoolConfig: locals.schoolMarkerData,
        }) %>
	</body>
</html>
