<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%- include('partials/head', { title }) %>

	<%
		const groups = documentation?.groups || []
		const stats = documentation?.stats || {}
		const groupIconByType = {
			views: 'fa-solid fa-window-maximize',
			source: 'fa-solid fa-code',
			client: 'fa-solid fa-desktop',
			style: 'fa-solid fa-palette'
		}
	%>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
		<main class="theme-main flex-1 pt-0!">
			<%- include('partials/admin_nav', { selected: { docs: true } }) %>

			<section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10 space-y-6">
				<!-- Header -->
				<div class="mb-2 text-center">
					<p class="theme-kicker">Ritje Admin</p>
					<h1 class="theme-heading theme-accent-text">Broncode</h1>
					<p class="theme-subtext">Bekijk bronbestanden en documentatie op een plek.</p>
				</div>

				<!-- Stats -->
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Mappen</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.directoryCount || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Bestanden</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.fileCount || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Secties</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.groupCount || groups.length || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Regels Code</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.lineCount || 0 %></p>
					</div>
				</div>

				<!-- Search -->
				<div class="theme-panel p-4 md:p-5">
					<label for="docsSearch" class="block text-sm font-semibold theme-text-primary">Zoeken</label>
					<input id="docsSearch" type="search" placeholder="Zoek op pad, bestandsnaam of tekst..." class="theme-input mt-3 w-full" />
				</div>

				<% if (groups.length === 0) { %>
					<article class="theme-panel p-8 md:p-10 text-center">
						<h2 class="text-xl font-extrabold theme-text-primary">Geen bestanden gevonden</h2>
						<p class="theme-subtext">De bronmappen zijn niet beschikbaar.</p>
					</article>
				<% } %>

				<!-- File Browser -->
				<% groups.forEach((group) => { %>
					<section class="space-y-4" data-doc-group data-group-key="<%= group.key %>">
						<div>
							<p class="theme-kicker"><%= group.rootPath %></p>
							<h2 class="text-2xl font-black theme-text-primary mt-1">
								<i class="<%= groupIconByType[group.type] || 'fa-solid fa-folder' %> mr-2 theme-accent-text"></i>
								<%= group.label %>
							</h2>
							<p class="theme-text-muted text-sm mt-1">
								<%= group.fileCount %> bestanden in <%= group.directoryCount %> mappen
							</p>
						</div>

						<div class="grid gap-6 lg:grid-cols-[300px_1fr] items-start">
							<!-- Folder Tree -->
							<aside class="theme-panel p-4 md:p-5 lg:sticky lg:top-24 max-h-[65vh] overflow-y-auto">
								<h3 class="text-xs font-bold uppercase tracking-[0.18em] theme-text-muted mb-4">Mappen</h3>
								<div class="docs-tree text-sm">
									<% (group.tree || []).forEach((node) => { %>
										<%- include('partials/docs_tree_node', { node }) %>
									<% }) %>
								</div>
							</aside>

							<!-- Files -->
							<div class="space-y-4">
								<% group.files.forEach((file) => { %>
									<article
										id="<%= file.anchorId %>"
										data-doc-file-card
										data-doc-path="<%= `${group.rootLabel}/${file.relativePath}` %>"
										class="docs-file-card theme-panel overflow-hidden"
									>
										<header class="p-5 md:p-6 border-b theme-border-soft">
											<div class="flex flex-wrap items-start justify-between gap-3">
												<div>
													<p class="theme-kicker text-xs"><%= group.label %></p>
													<h3 class="text-lg font-bold theme-text-primary mt-1 break-all"><%= file.name %></h3>
													<p class="theme-text-muted text-xs mt-1 font-mono break-all"><%= group.rootLabel %>/<%= file.relativePath %></p>
												</div>
												<div class="flex flex-wrap gap-2 shrink-0">
													<span class="theme-pill theme-surface border theme-border px-2 py-1 text-xs">.<%= file.extension || 'noext' %></span>
													<span class="theme-pill theme-surface border theme-border px-2 py-1 text-xs"><%= file.lineCount %> ln</span>
													<span class="theme-pill theme-surface border theme-border px-2 py-1 text-xs"><%= file.sizeLabel %></span>
												</div>
											</div>
										</header>

										<% if (file.documentation || file.source) { %>
											<div class="grid md:grid-cols-2 gap-0">
												<% if ((file.documentationSections || []).length) { %>
													<div class="theme-surface border-r theme-border-soft border-b md:border-b-0 p-4 md:p-5 max-h-96 overflow-y-auto">
														<div class="docs-doc-header">
															<p class="text-xs font-bold uppercase tracking-[0.12em] theme-text-muted">Documentatie</p>
															<span class="docs-doc-count"><%= file.documentationSections.length %> blokken</span>
														</div>
														<div class="docs-doc-sections mt-3">
															<% file.documentationSections.forEach((section, index) => { %>
																<details class="docs-doc-section" <%= index === 0 ? 'open' : '' %>>
																	<summary class="docs-doc-section-summary">
																		<span class="docs-doc-title"><%- section.title %></span>
																		<span class="docs-doc-line">regel <%= section.lineNumber %></span>
																	</summary>
																	<pre class="theme-code text-xs mt-2"><code><%- section.content %></code></pre>
																</details>
															<% }) %>
														</div>
													</div>
												<% } else if (file.documentation) { %>
													<div class="theme-surface border-r theme-border-soft border-b md:border-b-0 p-4 md:p-5 max-h-96 overflow-y-auto">
														<p class="text-xs font-bold uppercase tracking-[0.12em] theme-text-muted mb-3">Documentatie</p>
														<pre class="theme-code text-xs"><code><%- file.documentation %></code></pre>
													</div>
												<% } else { %>
													<div class="theme-surface border-r theme-border-soft border-b md:border-b-0 p-4 md:p-5 max-h-96 overflow-y-auto">
														<p class="text-xs font-bold uppercase tracking-[0.12em] theme-text-muted mb-3">Documentatie</p>
														<p class="theme-text-muted text-xs">Geen documentatieblokken gevonden.</p>
													</div>
												<% } %>
												<% if (file.source) { %>
													<div class="p-4 md:p-5 max-h-96 overflow-y-auto">
														<p class="text-xs font-bold uppercase tracking-[0.12em] theme-text-muted mb-3">Broncode</p>
														<pre class="theme-code text-xs"><code><%- file.source %></code></pre>
													</div>
												<% } %>
											</div>
										<% } %>
									</article>
								<% }) %>
							</div>
						</div>
					</section>
				<% }) %>
			</section>
		</main>
		<script src="/js/admin_docs.js"></script>
		<%- include('partials/footer') %>
	</body>
</html>
