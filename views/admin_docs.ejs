<!DOCTYPE html>
<html lang="nl" class="text-slate-200">
	<%- include('partials/head', { title }) %>

	<%
		const groups = documentation?.groups || []
		const stats = documentation?.stats || {}
		const groupIconByType = {
			views: 'fa-solid fa-window-maximize',
			source: 'fa-solid fa-code',
			client: 'fa-solid fa-desktop',
			style: 'fa-solid fa-palette'
		}
	%>

	<body class="theme-body min-h-screen flex flex-col">
		<%- include('partials/header', { user }) %>
		<main class="theme-main flex-1 pt-0!">
			<%- include('partials/admin_nav', { selected: { docs: true } }) %>

			<section class="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10 space-y-6">
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Mappen</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.directoryCount || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Bestanden</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.fileCount || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Secties</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.groupCount || groups.length || 0 %></p>
					</div>
					<div class="theme-panel p-5">
						<p class="theme-text-muted text-xs uppercase tracking-[0.12em]">Regels Code</p>
						<p class="text-3xl font-black theme-text-primary mt-2"><%= stats.lineCount || 0 %></p>
					</div>
				</div>

				<div class="theme-panel p-4 md:p-5">
					<label for="docsSearch" class="block text-sm font-semibold theme-text-primary">Zoeken</label>
					<input id="docsSearch" type="search" placeholder="Zoek op pad, bestandsnaam of beschrijving..." class="theme-input mt-3 w-full" />
				</div>

				<% if (groups.length === 0) { %>
					<article class="theme-panel p-8 md:p-10 text-center">
						<h2 class="text-xl font-extrabold theme-text-primary">Geen bestanden gevonden</h2>
						<p class="theme-subtext">De bronmappen zijn niet beschikbaar.</p>
					</article>
				<% } %>

				<% groups.forEach((group) => { %>
					<section class="space-y-4" data-doc-group data-group-key="<%= group.key %>">
						<div class="theme-panel p-4 md:p-5">
							<p class="theme-kicker"><%= group.rootPath %></p>
							<h2 class="text-2xl font-black theme-text-primary mt-1">
								<i class="<%= groupIconByType[group.type] || 'fa-solid fa-folder' %> mr-2 theme-accent-text"></i>
								<%= group.label %>
							</h2>
							<p class="theme-text-muted text-sm mt-1"><%= group.fileCount %> bestanden in <%= group.directoryCount %> mappen</p>
						</div>

						<div class="grid gap-6 lg:grid-cols-[290px_1fr] items-start">
							<aside class="theme-panel p-4 md:p-5 lg:sticky lg:top-24 max-h-[65vh] overflow-y-auto">
								<h3 class="text-xs font-bold uppercase tracking-[0.18em] theme-text-muted mb-4">Mappen</h3>
								<div class="docs-tree text-sm">
									<% (group.tree || []).forEach((node) => { %>
										<%- include('partials/docs_tree_node', { node }) %>
									<% }) %>
								</div>
							</aside>

							<div class="theme-panel overflow-hidden">
								<ul class="divide-y theme-border-soft">
									<% group.files.forEach((file) => {
										const firstSection = (file.documentationSections || [])[0]
										const description = firstSection?.content || 'Geen documentatie gevonden.'
										const shortDescription = description.length > 180 ? `${description.slice(0, 177)}...` : description
										const fileLink = `/admin/docs/file?groupKey=${encodeURIComponent(group.key)}&filePath=${encodeURIComponent(file.relativePath)}`
									%>
										<li
											id="<%= file.anchorId %>"
											class="p-4 md:p-5"
											data-doc-file-card
											data-doc-path="<%= `${group.rootLabel}/${file.relativePath}` %>"
										>
											<div class="flex items-start justify-between gap-4">
												<div class="min-w-0">
													<p class="theme-text-primary font-semibold break-all"><%= file.relativePath %></p>
													<p class="theme-text-muted text-sm mt-1"><%= shortDescription %></p>
													<div class="mt-2 flex flex-wrap gap-2 text-xs">
														<span class="theme-surface border theme-border rounded-md px-2 py-1">.<%= file.extension || 'noext' %></span>
														<span class="theme-surface border theme-border rounded-md px-2 py-1"><%= file.lineCount %> regels</span>
														<span class="theme-surface border theme-border rounded-md px-2 py-1"><%= (file.documentationSections || []).length %> doc blokken</span>
													</div>
												</div>
												<a href="<%= fileLink %>" class="theme-btn-secondary px-3 py-2 text-sm shrink-0">Open bestand</a>
											</div>
										</li>
									<% }) %>
								</ul>
							</div>
						</div>
					</section>
				<% }) %>
			</section>
		</main>
		<script src="/js/admin_docs.js"></script>
		<%- include('partials/footer') %>
	</body>
</html>
