{
	"source": {
		"include": ["src"],
		"includePattern": ".+\\.js$",
		"excludePattern": "(node_modules)"
	},
	"opts": {
		"destination": "./docs",
		"recurse": true,
		"readme": "./package.json",
		"private": false,
		"lenient": true
	},
	"plugins": ["plugins/markdown"],
	"templates": {
		"cleverLinks": false,
		"monospaceLinks": false,
		"default": {
			"outputSourceFiles": true
		}
	}
}
